+    fprintf(f, "render_scale=%d\nwidescreen=%d\nhud_edges=%d\nsmooth=%d\nfullscreen=%d\nfps_counter=%d\nunlock_cars=%d\nunlock_tracks=%d\n",
+            set_scale ? nv2a_gl_get_scale() : 0, set_wide, set_hud_edges, set_smooth, set_full, osd_on, set_cars,
