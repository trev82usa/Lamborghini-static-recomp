+static uint64_t hash_bytes(const void *p, size_t n)
+{
+    const uint8_t *b = (const uint8_t *)p;
+    uint64_t h = 0x9E3779B97F4A7C15ull ^ n;
+    size_t i = 0;
+    /* Four independent lanes over 32-byte blocks: the per-frame texture
+     * check hashes every texture in use, so this has to run near memory
+     * speed. */
+    if (n >= 64) {
+        uint64_t l[4] = { h, h ^ 0x632BE59BD9B4E019ull, h ^ 0x85EBCA77C2B2AE63ull,
+                          h ^ 0xC2B2AE3D27D4EB4Full };
+        for (; i + 32 <= n; i += 32) {
+            uint64_t w[4];
+            int k;
+            memcpy(w, b + i, 32);
+            for (k = 0; k < 4; k++) {
+                l[k] = (l[k] ^ w[k]) * 0x100000001B3ull;
+                l[k] ^= l[k] >> 29;
+            }
+        }
+        h = ((l[0] * 31u + l[1]) * 31u + l[2]) * 31u + l[3];
+        h ^= h >> 31;
+    }
+    for (; i + 8 <= n; i += 8) {
+        uint64_t w;
+        memcpy(&w, b + i, 8);
+        h = (h ^ w) * 0x100000001B3ull;
+        h ^= h >> 29;
+    }
+    for (; i < n; i++)
+        h = (h ^ b[i]) * 0x100000001B3ull;
+    return h;
+}
