+/* Match each component of path after its first `keep` bytes to the entry on
+ * disk that differs only in case, when the exact name is missing. Stops at
+ * the first component with no match at all (a file being created keeps the
+ * title's spelling from there on). */
+static void fold_path_case(char *path, size_t keep)
+{
+    struct stat st;
+    char *p;
+
+    if (stat(path, &st) == 0 || strlen(path) <= keep)
+        return;
+    p = path + keep;
+    while (*p == '/')
+        p++;
+    while (*p) {
+        char *end = strchr(p, '/');
+        char saved = end ? *end : 0;
+        if (end)
+            *end = 0;
+        if (stat(path, &st) != 0) {
+            /* Look for a case-insensitive match in the parent directory. */
+            char *slash = strrchr(path, '/');
+            DIR *d;
+            struct dirent *e;
+            int found = 0;
+            if (!slash) {
+                if (end) *end = saved;
+                return;
+            }
+            *slash = 0;
+            d = opendir(slash == path ? "/" : path);
+            *slash = '/';
+            if (d) {
+                while ((e = readdir(d)) != NULL) {
+                    if (strcasecmp(e->d_name, p) == 0
+                        && strlen(e->d_name) == strlen(p)) {
+                        memcpy(p, e->d_name, strlen(p));
+                        found = 1;
+                        break;
+                    }
+                }
+                closedir(d);
+            }
+            if (!found) {
+                if (end) *end = saved;
+                return;
+            }
+        }
+        if (!end)
+            return;
+        *end = saved;
+        p = end + 1;
+    }
+}
