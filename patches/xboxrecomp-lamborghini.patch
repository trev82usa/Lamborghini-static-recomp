+    {'A', 0x2BED}, {'B', 0x6BAE}, {'C', 0x3923}, {'D', 0x6B6E}, {'E', 0x79A7},
+    {'F', 0x79A4}, {'G', 0x396B}, {'H', 0x5BED}, {'I', 0x7497}, {'J', 0x126A},
+    {'K', 0x5BAD}, {'L', 0x4927}, {'M', 0x5FED}, {'N', 0x6B6D}, {'O', 0x7B6F},
+    {'P', 0x7BE4}, {'Q', 0x2B73}, {'R', 0x6BAD}, {'S', 0x79CF}, {'T', 0x7492},
+    {'U', 0x5B6F}, {'V', 0x5B6A}, {'W', 0x5BFD}, {'X', 0x5AAD}, {'Y', 0x5A92},
+    {'Z', 0x72A7}, {'0', 0x7B6F}, {'1', 0x2C97}, {'2', 0x73E7}, {'3', 0x73CF},
+    {'4', 0x5BC9}, {'5', 0x79CF}, {'6', 0x79EF}, {'7', 0x7292}, {'8', 0x7BEF},
+    {'9', 0x7BCF}, {'.', 0x0002}, {'/', 0x12A4}, {'(', 0x2922}, {')', 0x224A},
