+/* ── Context ─────────────────────────────────────────────────────────── */
+
+#if defined(_WIN32)
+/* Windows (XBOX_SDL_HOST): a WGL context on a hidden window owned by the
+ * executor thread. Everything is drawn into framebuffer objects and read
+ * back for the SDL window, as with the surfaceless EGL context on Linux, so
+ * the window's own framebuffer is never used and the window never shown. */
+static int ctx_platform_create(void)
+{
+    static const int cattr[] = {
+        WGL_CONTEXT_MAJOR_VERSION_ARB, 4, WGL_CONTEXT_MINOR_VERSION_ARB, 3,
+        WGL_CONTEXT_PROFILE_MASK_ARB, WGL_CONTEXT_CORE_PROFILE_BIT_ARB,
+        0 };
+    PIXELFORMATDESCRIPTOR pfd;
+    WNDCLASSA wc;
+    HGLRC tmp;
+    int pf;
+
+    memset(&wc, 0, sizeof wc);
+    wc.style = CS_OWNDC;
+    wc.lpfnWndProc = DefWindowProcA;
+    wc.hInstance = GetModuleHandleA(NULL);
+    wc.lpszClassName = "xboxrecomp_nv2a_gl";
+    RegisterClassA(&wc);
+    s_hwnd = CreateWindowA(wc.lpszClassName, "nv2a_gl", WS_OVERLAPPEDWINDOW,
+                           0, 0, 64, 64, NULL, NULL, wc.hInstance, NULL);
+    s_hdc = s_hwnd ? GetDC(s_hwnd) : NULL;
+    if (!s_hdc) {
+        fprintf(stderr, "[GL] cannot create the WGL window (%lu)\n", GetLastError());
+        return 0;
+    }
+    memset(&pfd, 0, sizeof pfd);
+    pfd.nSize = sizeof pfd;
+    pfd.nVersion = 1;
+    pfd.dwFlags = PFD_DRAW_TO_WINDOW | PFD_SUPPORT_OPENGL | PFD_DOUBLEBUFFER;
+    pfd.iPixelType = PFD_TYPE_RGBA;
+    pfd.cColorBits = 32;
+    pfd.cDepthBits = 24;
+    pfd.cStencilBits = 8;
+    pf = ChoosePixelFormat(s_hdc, &pfd);
+    if (!pf || !SetPixelFormat(s_hdc, pf, &pfd)) {
+        fprintf(stderr, "[GL] no OpenGL pixel format (%lu)\n", GetLastError());
+        return 0;
+    }
+    /* A legacy context first: wglCreateContextAttribsARB is an extension. */
+    tmp = wglCreateContext(s_hdc);
+    if (!tmp || !wglMakeCurrent(s_hdc, tmp)) {
+        fprintf(stderr, "[GL] wglCreateContext failed (%lu)\n", GetLastError());
+        return 0;
+    }
+    if (epoxy_has_wgl_extension(s_hdc, "WGL_ARB_create_context_profile"))
+        s_glrc = wglCreateContextAttribsARB(s_hdc, NULL, cattr);
+    wglMakeCurrent(NULL, NULL);
+    wglDeleteContext(tmp);
+    if (!s_glrc || !wglMakeCurrent(s_hdc, s_glrc)) {
+        fprintf(stderr, "[GL] cannot create an OpenGL 4.3 core context (%lu)\n",
+                GetLastError());
+        return 0;
+    }
+    fprintf(stderr, "[GL] WGL, %s / %s\n",
+            (const char *)glGetString(GL_RENDERER),
+            (const char *)glGetString(GL_VERSION));
+    return 1;
+}
+#else
+static int ctx_platform_create(void)
+{
+    static const EGLint cattr[] = {
+        EGL_CONTEXT_MAJOR_VERSION, 4, EGL_CONTEXT_MINOR_VERSION, 3,
+        EGL_CONTEXT_OPENGL_PROFILE_MASK, EGL_CONTEXT_OPENGL_CORE_PROFILE_BIT,
+        EGL_NONE };
+    EGLint major, minor;
+
+    /* Through eglGetProcAddress: libepoxy will not dispatch the EGL 1.5
+     * eglGetPlatformDisplay before a display exists to report a version. */
+    PFNEGLGETPLATFORMDISPLAYEXTPROC get_platform_display =
+        (PFNEGLGETPLATFORMDISPLAYEXTPROC)eglGetProcAddress("eglGetPlatformDisplayEXT");
+
+    s_dpy = get_platform_display
+          ? get_platform_display(EGL_PLATFORM_SURFACELESS_MESA, EGL_DEFAULT_DISPLAY, NULL)
+          : EGL_NO_DISPLAY;
+    if (s_dpy == EGL_NO_DISPLAY || !eglInitialize(s_dpy, &major, &minor)) {
+        fprintf(stderr, "[GL] no surfaceless EGL display\n");
+        return 0;
+    }
+    if (!eglBindAPI(EGL_OPENGL_API)) {
+        fprintf(stderr, "[GL] eglBindAPI(OpenGL) failed\n");
+        return 0;
+    }
+    s_ctx = eglCreateContext(s_dpy, EGL_NO_CONFIG_KHR, EGL_NO_CONTEXT, cattr);
+    if (s_ctx == EGL_NO_CONTEXT
+            || !eglMakeCurrent(s_dpy, EGL_NO_SURFACE, EGL_NO_SURFACE, s_ctx)) {
+        fprintf(stderr, "[GL] cannot create an OpenGL 4.3 core context (0x%X)\n",
+                eglGetError());
+        return 0;
+    }
+    fprintf(stderr, "[GL] EGL %d.%d, %s / %s\n", major, minor,
+            (const char *)glGetString(GL_RENDERER),
+            (const char *)glGetString(GL_VERSION));
+    return 1;
+}
+#endif
+
+static int ctx_create(void)
+{
+    if (!ctx_platform_create())
+        return 0;
+    if (!build_program())
+        return 0;
+
+    /* Depth straight into [0,1] (the hardware's own range): the default
+     * [-1,1] mapping halves the precision near the far end, where a whole
+     * track lives (z/zmax 0.995..1), and distant trees came through walls. */
+    if (epoxy_has_gl_extension("GL_ARB_clip_control") || epoxy_gl_version() >= 45) {
+        const char *e = getenv("RECOMP_GL_Z01");
+        if (!(e && *e == '0')) {
+            glClipControl(GL_LOWER_LEFT, GL_ZERO_TO_ONE);
+            s_z01 = 1;
+        }
+    }
+    {
+        const char *e = getenv("RECOMP_GL_SCALE");
+        s_scale = e ? (int)(atof(e) * 100.0 + 0.5) : 100;
+        if (s_scale < 100) s_scale = 100;
+        if (s_scale > 600) s_scale = 600;
+        if (SCALED)
+            fprintf(stderr, "[GL] internal resolution x%.2f\n", s_scale / 100.0);
+    }
+    glGenVertexArrays(1, &s_vao);
+    glBindVertexArray(s_vao);
+    glGenBuffers(1, &s_vbo);
+    glBindBuffer(GL_ARRAY_BUFFER, s_vbo);
+#define ATTR(i, n, f) \
+    glEnableVertexAttribArray(i); \
+    glVertexAttribPointer(i, n, GL_FLOAT, GL_FALSE, sizeof(NvGlVertex), \
+                          (const void *)offsetof(NvGlVertex, f))
+    ATTR(0, 4, pos); ATTR(1, 4, d0); ATTR(2, 4, d1); ATTR(3, 1, fog);
+    ATTR(4, 4, tex[0]); ATTR(5, 4, tex[1]); ATTR(6, 4, tex[2]); ATTR(7, 4, tex[3]);
+#undef ATTR
+    if (s_prog_vsh) {
+        glGenVertexArrays(1, &s_vao_vsh);
+        glGenBuffers(1, &s_vbo_vsh);
+        glGenBuffers(1, &s_ibo_vsh);
+        glBindVertexArray(s_vao_vsh);
+        glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, s_ibo_vsh);
+        glBindVertexArray(s_vao);
+    }
+    /* No near/far clipping: the executor has clipped at the near plane, and
+     * the software rasteriser never clipped depth either. */
+    glEnable(GL_DEPTH_CLAMP);
+    glEnable(GL_SCISSOR_TEST);
+    glEnable(GL_PROGRAM_POINT_SIZE);
+    glPixelStorei(GL_PACK_ALIGNMENT, 1);
+    glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+    return 1;
+}
+
+int nv2a_gl_enabled(void)
+{
+    if (s_state < 0) {
+        const char *e = getenv("RECOMP_GL");
+        s_state = 0;
+        if (e && *e && *e != '0') {
+            s_thread = pthread_self();
+            s_state = ctx_create();
+            fprintf(stderr, "[GL] host GPU pixel path %s\n",
+                    s_state ? "on" : "unavailable; software rasteriser");
+        }
+    }
+    if (s_state && !pthread_equal(s_thread, pthread_self())) {
+        static int warned;
+        if (!warned++)
+            fprintf(stderr, "[GL] called from a second thread; ignored\n");
+        return 0;
+    }
+    return s_state;
+}
+
+void nv2a_gl_set_decoder(NvGlDecodeFn fn)
+{
+    s_decode = fn;
+}
+
+/* ── Surfaces ────────────────────────────────────────────────────────── */
+
+typedef struct {
+    uint32_t va, pitch, bpp, swz, w, h;
+    GLuint tex, fbo;
+    uint64_t mem_hash;      /* guest memory as of the last upload/readback */
+    uint32_t checked_frame; /* last frame guest memory was compared */
+    int dirty;              /* drawn since guest memory was last updated */
+    int used;
+    uint32_t consumed;      /* frame the GPU last presented/sampled it (0 never) */
+    int sx;                 /* horizontal scale, hundredths (s_scale_x for screen targets) */
+} Surf;
+
+static Surf s_surf[MAX_SURF];
+static int s_cur = -1;      /* the surface being drawn */
+static uint32_t s_use_clock, s_frame = 1;
+
+static struct { uint32_t key; GLuint tex; int used; } s_z[MAX_ZBUF];
+static uint32_t s_z_attached_key = 0xFFFFFFFFu;
+static int s_z_next;
+
+static size_t surf_bytes(const Surf *s)
+{
+    return s->swz ? (size_t)s->w * s->h * s->bpp : (size_t)s->pitch * s->h;
+}
+
+static int surf_overlaps(const Surf *s, uint64_t a0, uint64_t a1)
+{
+    return s->tex && a0 < (uint64_t)s->va + surf_bytes(s) && a1 > (uint64_t)s->va;
+}
+
+static uint64_t surf_hash(const Surf *s)
+{
+    return hash_bytes(guest(s->va), surf_bytes(s));
+}
+
+/* Guest memory -> texture. */
+static void surf_upload(Surf *s)
+{
+    uint64_t t0 = xbox_HostNowNs();
+    const uint8_t *src = guest(s->va);
+    GLenum fmt = s->bpp == 4 ? GL_BGRA : GL_RGB;
+    GLenum type = s->bpp == 4 ? GL_UNSIGNED_INT_8_8_8_8_REV : GL_UNSIGNED_SHORT_5_6_5;
+    uint8_t *tmp = NULL;
+
+    if (SCALED) {
+        tmp_ensure(s->w, s->h);
+        glBindTexture(GL_TEXTURE_2D, s_tmp_tex);
+    } else
+        glBindTexture(GL_TEXTURE_2D, s->tex);
+    if (s->swz) {
+        uint32_t mx, my, x, y;
+        tmp = (uint8_t *)malloc((size_t)s->w * s->h * s->bpp);
+        if (!tmp)
+            return;
+        xbox_swizzle_masks(s->w, s->h, &mx, &my);
+        for (y = 0; y < s->h; y++)
+            for (x = 0; x < s->w; x++) {
+                size_t i = deposit(x, mx) | deposit(y, my);
+                memcpy(tmp + ((size_t)y * s->w + x) * s->bpp, src + i * s->bpp, s->bpp);
+            }
+        glPixelStorei(GL_UNPACK_ROW_LENGTH, 0);
+        glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, s->w, s->h, fmt, type, tmp);
+        free(tmp);
+    } else {
+        glPixelStorei(GL_UNPACK_ROW_LENGTH, s->pitch / s->bpp);
+        glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, s->w, s->h, fmt, type, src);
+        glPixelStorei(GL_UNPACK_ROW_LENGTH, 0);
+    }
+    if (SCALED)                   /* staged at 1x, then scaled up */
+        scale_blit(s->fbo, s->w, s->h, 0, s->sx);
+    s->mem_hash = surf_hash(s);
+    s->checked_frame = s_frame;
+    G.uploads++;
+    G.ns_upload += xbox_HostNowNs() - t0;
+}
+
+/* Texture -> guest memory. */
+static void surf_readback(Surf *s)
+{
+    uint64_t t0 = xbox_HostNowNs();
+    uint8_t *dst = guest(s->va);
+    GLenum fmt = s->bpp == 4 ? GL_BGRA : GL_RGB;
+    GLenum type = s->bpp == 4 ? GL_UNSIGNED_INT_8_8_8_8_REV : GL_UNSIGNED_SHORT_5_6_5;
+
+    if (SCALED)
+        scale_blit(s->fbo, s->w, s->h, 1, s->sx);   /* leaves the 1x copy bound to read */
+    else
+        glBindFramebuffer(GL_READ_FRAMEBUFFER, s->fbo);
+    if (s->swz) {
+        uint32_t mx, my, x, y;
+        uint8_t *tmp = (uint8_t *)malloc((size_t)s->w * s->h * s->bpp);
+        if (!tmp)
+            return;
+        glPixelStorei(GL_PACK_ROW_LENGTH, 0);
+        glReadPixels(0, 0, s->w, s->h, fmt, type, tmp);
+        xbox_swizzle_masks(s->w, s->h, &mx, &my);
+        for (y = 0; y < s->h; y++)
+            for (x = 0; x < s->w; x++) {
+                size_t i = deposit(x, mx) | deposit(y, my);
+                memcpy(dst + i * s->bpp, tmp + ((size_t)y * s->w + x) * s->bpp, s->bpp);
+            }
+        free(tmp);
+    } else {
+        glPixelStorei(GL_PACK_ROW_LENGTH, s->pitch / s->bpp);
+        glReadPixels(0, 0, s->w, s->h, fmt, type, dst);
+        glPixelStorei(GL_PACK_ROW_LENGTH, 0);
+    }
+    s->mem_hash = surf_hash(s);
+    s->checked_frame = s_frame;
+    s->dirty = 0;
+    s_epoch++;              /* textures decoded from this memory are stale */
+    G.readbacks++;
+    G.ns_readback += xbox_HostNowNs() - t0;
+}
+
+static int s_rb_why;
+static void surf_sync(Surf *s)
+{
+    /* Guest memory changed since the GPU took this surface (an upload or a
+     * readback set mem_hash): the title has reused the memory -- after it
+     * waited for the GPU, so the GPU's pixels are older than what is there
+     * now. Writing them back clobbered it: Lamborghini frees a render target
+     * and loads the challenge car's vertices into the same memory, and the
+     * write-back zeroed them (the car showed as four wheels, and a later
+     * pass divided by an empty table and crashed). Drop the GPU copy.
+     * RECOMP_GL_RB_GUARD=0 writes back regardless, as before. */
+    if (s->tex && s->dirty && s->mem_hash) {
+        static int guard = -1;
+        if (guard < 0) {
+            const char *e = getenv("RECOMP_GL_RB_GUARD");
+            guard = !(e && *e == '0');
+        }
+        if (guard && surf_hash(s) != s->mem_hash) {
+            static int logged;
+            if (logged++ < 20)
+                fprintf(stderr, "[GL] surface %08X %ux%u: guest memory reused since the GPU drew it;"
+                        " not written back\n", s->va, s->w, s->h);
+            G.rb_skipped++;
+            s->dirty = 0;
+            s->checked_frame = 0;           /* re-upload before it is drawn again */
+            s->mem_hash = 0;
+            return;
+        }
+    }
+    if (s->tex && s->dirty) {
+        static int log_n = -1;
+        if (s_rb_why == 2)
+            s->consumed = s_frame;  /* the GPU reads it as a texture */
+        if (log_n < 0)
+            log_n = getenv("RECOMP_GL_SYNC_LOG") ? 0 : 1 << 30;
+        if (log_n < 400) {
+            log_n++;
+            fprintf(stderr, "[GLSYNC] why %d va %08X %ux%u bpp %u swz %u\n",
+                    s_rb_why, s->va, s->w, s->h, s->bpp, s->swz);
+        }
+        G.rb_why[s_rb_why]++;
+        surf_readback(s);
+    }
+}
+
+static void surf_free(int i)
+{
+    Surf *s = &s_surf[i];
+    s_rb_why = 3;
+    surf_sync(s);
+    if (s->fbo) glDeleteFramebuffers(1, &s->fbo);
+    if (s->tex) glDeleteTextures(1, &s->tex);
+    memset(s, 0, sizeof *s);
+    if (s_cur == i)
+        s_cur = -1;
+}
+
+/* Every dirty surface overlapping [a0, a1) into guest memory, except `skip`. */
+static void sync_range(uint64_t a0, uint64_t a1, int skip)
+{
+    int i;
+    for (i = 0; i < MAX_SURF; i++)
+        if (i != skip && s_surf[i].dirty && surf_overlaps(&s_surf[i], a0, a1))
+            surf_sync(&s_surf[i]);
+}
+
+/* The GPU caught up with PUT: write back every surface the title has
+ * finished drawing (all but the current render target), which it may now
+ * read with the CPU. The one being drawn stays on the GPU until it is left,
+ * flipped or sampled. */
+static uint64_t s_last_flip_ns;
+static int s_pred_k;            /* visibility tests so far this frame */
+/* RECOMP_GL_SYNC_CUR=1: the current render target too (if the GPU has not
+ * used it lately). Experimental. */
+static int s_cur_sync = -1;
+
+void nv2a_gl_sync_small(void)
+{
+    int i;
+    if (s_cur_sync < 0) {
+        const char *e = getenv("RECOMP_GL_SYNC_CUR");
+        s_cur_sync = e && *e == '1';
+    }
+    if (s_state != 1 || !pthread_equal(s_thread, pthread_self()))
+        return;
+
+    s_rb_why = 4;
+    /* Skipped: the current render target, and surfaces the GPU itself has
+     * used in the last 8 frames (presented, sampled, copied into a cube map)
+     * -- a surface the GPU once used and then left (the car paint target
+     * between races) counts as left again, or race 2's paint never synced --
+     * in a race those are the back buffer and the glow buffer, rewritten
+     * every frame, and writing them back at every kick cost a quarter of
+     * the frame. What is left are surfaces only ever drawn and then left,
+     * which is what a title reads with the CPU (Lamborghini's car paint,
+     * drawn into a 512x512 target and compressed into the car's texture). */
+    for (i = 0; i < MAX_SURF; i++)
+        if ((i != s_cur || s_cur_sync) && (!s_surf[i].consumed || s_frame - s_surf[i].consumed > 8))
+            surf_sync(&s_surf[i]);
+}
+
+void nv2a_gl_sync_all(void)
+{
+    int i;
+    if (s_state != 1 || !pthread_equal(s_thread, pthread_self()))
+        return;
+    s_rb_why = 4;
+    for (i = 0; i < MAX_SURF; i++)
+        surf_sync(&s_surf[i]);
+}
+
+static void scale_change(int r);
+
+/* The flip. A glReadPixels straight into guest memory waits for the GPU to
+ * finish the frame (4-5 ms a frame in a race). Instead the frame is read into
+ * a pixel buffer with a fence, and the window gets the previous frame's
+ * buffer, which has long finished: one frame of latency, no stall. Guest
+ * memory for the surface is left as it was (the surface stays dirty and is
+ * written back when anything does need it). */
+extern void xbox_FramebufferWindowPresentHost(const void *px, uint32_t pitch);
+
+static GLuint s_pbo[2];
+static GLsync s_pbo_fence[2];
+static uint32_t s_pbo_pitch[2], s_pbo_size[2], s_pbo_w[2], s_pbo_h[2];
+static int s_pbo_i;
+
+int nv2a_gl_present(uint32_t va, uint32_t pitch)
+{
+    int i, idx = -1, j;
+    Surf *s;
+
+    s_last_flip_ns = xbox_HostNowNs();
+    s_pred_k = 0;
+    if (s_state != 1 || !pthread_equal(s_thread, pthread_self()))
+        return 0;
+    s_frame++;
+    {
+        int r = __atomic_exchange_n(&s_scale_req, 0, __ATOMIC_ACQ_REL);
+        int x = __atomic_exchange_n(&s_xs_req, 0, __ATOMIC_ACQ_REL);
+        if (x >= 100 && x <= 300 && x != s_stretch) {
+            s_stretch = x;
+            if (!(r >= 100 && r <= 600))
+                r = s_scale;
+            scale_change(r);
+        } else if (r >= 100 && r <= 600 && r != s_scale)
+            scale_change(r);
+    }
+    s_epoch++;
+    for (i = 0; i < MAX_SURF; i++)
+        if (s_surf[i].tex && s_surf[i].va == va && !s_surf[i].swz
+                && s_surf[i].pitch == pitch && s_surf[i].h >= 480
+                && s_surf[i].w >= 640)
+            idx = i;
+    if (idx < 0 || !s_surf[idx].dirty) {
+        /* Guest memory is current (or the GPU never drew it). */
+        s_rb_why = 0;
+        sync_range(va, (uint64_t)va + 1, -1);
+        return 0;
+    }
+    s = &s_surf[idx];
+    s->consumed = s_frame;
+    j = s_pbo_i;
+    if (!s_pbo[j])
+        glGenBuffers(1, &s_pbo[j]);
+    glBindBuffer(GL_PIXEL_PACK_BUFFER, s_pbo[j]);
+    {
+        /* At render scale 2x-4x the window gets the whole scaled frame
+         * (RECOMP_GL_HIRES=0: shrunk to 640x480 first, as guest memory is). */
+        static int hires_on = -1;
+        int hires;
+        uint32_t rw = 640, rh = 480, rp = pitch;
+        if (hires_on < 0) {
+            const char *e = getenv("RECOMP_GL_HIRES");
+            hires_on = !(e && *e == '0');
+        }
+        hires = SCALED && hires_on;
+        if (hires) {
+            rw = (uint32_t)SCX(s, 640); rh = (uint32_t)SC(480); rp = rw * 4;
+        }
+        if (s_pbo_size[j] < rp * rh) {
+            glBufferData(GL_PIXEL_PACK_BUFFER, (GLsizeiptr)rp * rh, NULL, GL_STREAM_READ);
+            s_pbo_size[j] = rp * rh;
+        }
+        if (SCALED && !hires)
+            scale_blit(s->fbo, 640, 480, 1, s->sx);
+        else
+            glBindFramebuffer(GL_READ_FRAMEBUFFER, s->fbo);
+        if (hires) {
+            glPixelStorei(GL_PACK_ROW_LENGTH, 0);
+            glReadPixels(0, 0, (GLsizei)rw, (GLsizei)rh, GL_BGRA,
+                         GL_UNSIGNED_INT_8_8_8_8_REV, (void *)0);
+        } else {
+            glPixelStorei(GL_PACK_ROW_LENGTH, pitch / s->bpp);
+            glReadPixels(0, 0, 640, 480, s->bpp == 4 ? GL_BGRA : GL_RGB,
+                         s->bpp == 4 ? GL_UNSIGNED_INT_8_8_8_8_REV : GL_UNSIGNED_SHORT_5_6_5,
+                         (void *)0);
+        }
+        glPixelStorei(GL_PACK_ROW_LENGTH, 0);
+        s_pbo_w[j] = rw; s_pbo_h[j] = rh; pitch = rp;
+    }
+    if (s_pbo_fence[j])
+        glDeleteSync(s_pbo_fence[j]);
+    s_pbo_fence[j] = glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
+    s_pbo_pitch[j] = pitch;
+    glFlush();
+
+    /* The previous frame. */
+    j ^= 1;
+    if (s_pbo_fence[j]) {
+        uint64_t t0 = xbox_HostNowNs();
+        glClientWaitSync(s_pbo_fence[j], GL_SYNC_FLUSH_COMMANDS_BIT, 100000000ull);
+        glDeleteSync(s_pbo_fence[j]);
+        s_pbo_fence[j] = 0;
+        glBindBuffer(GL_PIXEL_PACK_BUFFER, s_pbo[j]);
+        {
+            uint32_t ph = s_pbo_h[j] ? s_pbo_h[j] : 480;
+            const void *px = glMapBufferRange(GL_PIXEL_PACK_BUFFER, 0,
+                                              (GLsizeiptr)s_pbo_pitch[j] * ph,
+                                              GL_MAP_READ_BIT);
+            if (px) {
+                extern void xbox_FramebufferWindowPresentHostSized(const void *, uint32_t,
+                                                                   uint32_t, uint32_t);
+                if (s_pbo_w[j] > 640)
+                    xbox_FramebufferWindowPresentHostSized(px, s_pbo_pitch[j], s_pbo_w[j], ph);
+                else
+                    xbox_FramebufferWindowPresentHost(px, s_pbo_pitch[j]);
+                glUnmapBuffer(GL_PIXEL_PACK_BUFFER);
+            }
+        }
+        G.ns_present += xbox_HostNowNs() - t0;
+    }
+    glBindBuffer(GL_PIXEL_PACK_BUFFER, 0);
+    s_pbo_i ^= 1;
+    G.async_presents++;
+    return 1;
+}
+
+/* Make the state's colour surface current: find or create it, write back
+ * any other surface sharing its memory, and upload guest memory if the CPU
+ * changed it. Render targets otherwise stay on the GPU until something
+ * needs them in guest memory. */
+static Surf *surf_bind(const NvGlState *st)
+{
+    uint32_t w = st->swz ? st->swz_w : st->pitch / st->bpp;
+    uint32_t h = st->swz ? st->swz_h : st->clip_y + st->clip_h;
+    int i, idx = -1, fresh = 0;
+    Surf *s;
+
+    for (i = 0; i < MAX_SURF; i++)
+        if (s_surf[i].tex && s_surf[i].va == st->color_va
+                && s_surf[i].pitch == st->pitch && s_surf[i].bpp == st->bpp
+                && s_surf[i].swz == st->swz)
+            idx = i;
+    if (idx < 0) {
+        /* The same memory and size in the other layout. Lamborghini clears
+         * its cube-map faces as linear surfaces and then draws them
+         * swizzled; a clear reads the same either way. The GL texture holds
+         * the image in pixel order, so only guest memory cares: keep the
+         * pixels if they are newer than memory, else take memory's in the
+         * new layout. */
+        for (i = 0; i < MAX_SURF; i++)
+            if (s_surf[i].tex && s_surf[i].va == st->color_va
+                    && s_surf[i].bpp == st->bpp && s_surf[i].swz != st->swz
+                    && s_surf[i].w == w && s_surf[i].h == h
+                    && s_surf[i].pitch == st->pitch) {
+                idx = i;
+                s_surf[i].swz = st->swz;
+                if (!s_surf[i].dirty)
+                    s_surf[i].checked_frame = 0, s_surf[i].mem_hash = 0;
+                G.relabels++;
+                break;
+            }
+    }
+    if (idx == s_cur && idx >= 0 && s_surf[idx].w == w && s_surf[idx].h >= h)
+        return &s_surf[idx];                       /* the common case */
+    if (idx >= 0 && (s_surf[idx].w != w || s_surf[idx].h < h)) {
+        /* Grown (a taller clip than before): rebuild from guest memory. */
+        if (h < s_surf[idx].h)
+            h = s_surf[idx].h;
+        surf_free(idx);
+        idx = -1;
+    }
+    if (idx < 0) {
+        int lru = 0;
+        for (i = 0; i < MAX_SURF; i++) {
+            if (!s_surf[i].tex) { lru = i; break; }
+            if (s_surf[i].used < s_surf[lru].used) lru = i;
+        }
+        if (s_surf[lru].tex)
+            surf_free(lru);
+        idx = lru;
+        s = &s_surf[idx];
+        s->va = st->color_va; s->pitch = st->pitch; s->bpp = st->bpp;
+        s->swz = st->swz; s->w = w; s->h = h;
+        s->sx = (w >= 640 && h >= 480) ? s_scale_x : s_scale;
+        glGenTextures(1, &s->tex);
+        glBindTexture(GL_TEXTURE_2D, s->tex);
+        glTexStorage2D(GL_TEXTURE_2D, 1, GL_RGBA8, SCX(s, w), SC(h));
+        glGenFramebuffers(1, &s->fbo);
+        glBindFramebuffer(GL_DRAW_FRAMEBUFFER, s->fbo);
+        glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                               GL_TEXTURE_2D, s->tex, 0);
+        fresh = 1;
+    }
+    s = &s_surf[idx];
+    /* Another surface over the same memory (a different pitch or format
+     * view) holds newer pixels: into guest memory, then into this one. */
+    {
+        uint64_t a0 = s->va, a1 = s->va + surf_bytes(s);
+        for (i = 0; i < MAX_SURF; i++)
+            if (i != idx && s_surf[i].dirty && surf_overlaps(&s_surf[i], a0, a1)) {
+                s_rb_why = 1;
+                {
+                    static int shown;
+                    if (shown++ < 12)
+                        fprintf(stderr, "[GL] alias: binding %08X pitch %u bpp %u swz %u %ux%u"
+                                " over dirty %08X pitch %u bpp %u swz %u %ux%u\n",
+                                s->va, s->pitch, s->bpp, s->swz, s->w, s->h,
+                                s_surf[i].va, s_surf[i].pitch, s_surf[i].bpp,
+                                s_surf[i].swz, s_surf[i].w, s_surf[i].h);
+                }
+                surf_sync(&s_surf[i]);
+                if (!s->dirty)
+                    s->checked_frame = 0;       /* force the compare below */
+            }
+    }
+    if (fresh) {
+        surf_upload(s);
+    } else if (!s->dirty && s->checked_frame != s_frame) {
+        uint64_t t0 = xbox_HostNowNs();
+        G.rehash++;
+        s->checked_frame = s_frame;
+        if (surf_hash(s) != s->mem_hash)
+            surf_upload(s);             /* the CPU wrote it meanwhile */
+        G.ns_hash += xbox_HostNowNs() - t0;
+    }
+    s->used = (int)++s_use_clock;
+    s_cur = idx;
+    s_z_attached_key = 0xFFFFFFFFu;
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, s->fbo);
+    return s;
+}
+
+/* A surface a texture stage can sample in place: same memory, same layout,
+ * a colour format that reads the surface's pixels unchanged. *opaque is set
+ * for the X8 formats (alpha reads 1). */
+static Surf *surf_as_texture(const NvGlTex *t, int *opaque)
+{
+    int i, want_bpp;
+    uint32_t c = t->color;
+
+    if (t->cube)
+        return NULL;
+    switch (c) {
+    case 0x06: case 0x12: want_bpp = 4; *opaque = 0; break;   /* A8R8G8B8 */
+    case 0x07: case 0x1E: want_bpp = 4; *opaque = 1; break;   /* X8R8G8B8 */
+    case 0x05: case 0x11: want_bpp = 2; *opaque = 1; break;   /* R5G6B5 */
+    default: return NULL;
+    }
+    for (i = 0; i < MAX_SURF; i++) {
+        Surf *s = &s_surf[i];
+        if (!s->tex || s->va != t->offset || s->bpp != (uint32_t)want_bpp)
+            continue;
+        if (t->linear ? (s->swz || s->pitch != t->pitch || t->width > s->w
+                         || t->height > s->h)
+                      : (!s->swz || s->w != t->width || s->h != t->height))
+            continue;
+        return s;
+    }
+    return NULL;
+}
+
+/* Attach the depth buffer for zeta key `key` (0: none) to the current FBO. */
+static void zbuf_attach(uint32_t key, int want)
+{
+    int i, idx = -1;
+    GLuint tex = 0;
+
+    if (!want)
+        key = 0;
+    if (key == s_z_attached_key)
+        return;
+    if (key) {
+        for (i = 0; i < MAX_ZBUF; i++)
+            if (s_z[i].tex && s_z[i].key == key)
+                idx = i;
+        if (idx < 0) {
+            idx = s_z_next++ % MAX_ZBUF;
+            if (!s_z[idx].tex) {
+                glGenTextures(1, &s_z[idx].tex);
+                glBindTexture(GL_TEXTURE_2D, s_z[idx].tex);
+                glTexStorage2D(GL_TEXTURE_2D, 1, GL_DEPTH32F_STENCIL8,
+                               SCN(ZBUF_W, s_scale_x > s_scale ? s_scale_x : s_scale), SC(ZBUF_H));
+            }
+            s_z[idx].key = key;
+            /* A new buffer starts "far", as the software one does. */
+            glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_DEPTH_STENCIL_ATTACHMENT,
+                                   GL_TEXTURE_2D, s_z[idx].tex, 0);
+            glDisable(GL_SCISSOR_TEST);
+            glDepthMask(GL_TRUE);
+            glStencilMask(0xFF);
+            glClearDepth(1.0);
+            glClearStencil(0);
+            glClear(GL_DEPTH_BUFFER_BIT | GL_STENCIL_BUFFER_BIT);
+            glEnable(GL_SCISSOR_TEST);
+        }
+        tex = s_z[idx].tex;
+    }
+    glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_DEPTH_STENCIL_ATTACHMENT,
+                           GL_TEXTURE_2D, tex, 0);
+    s_z_attached_key = key;
+}
+
+/* ── Textures ────────────────────────────────────────────────────────── */
+
+typedef struct {
+    uint32_t offset, color, w, h, pitch, cube, palette;
+    uint64_t hash, sparse;
+    uint32_t checked_epoch, full_epoch;
+    GLuint tex;
+    uint32_t used;
+    /* Last sampler state set on it. */
+    uint32_t addr_u, addr_v, filter, border, border_color, params_set;
+    uint32_t levels;        /* GL mip levels allocated (1 = level 0 only) */
+    int scaled;             /* copied from s_scale-sized targets */
+    GLenum dxt;             /* compressed storage (DXT uploaded as is), or 0 */
+} TexEnt;
+
+/* RECOMP_GL_MIPMAPS=0: level 0 only, as before. Otherwise a texture the
+ * title gives mip levels gets a full GPU-generated chain, so distant
+ * surfaces (trees, fences, road) are filtered as on the console instead of
+ * sparkling. */
+static int mips_on(void)
+{
+    static int on = -1;
+    if (on < 0) {
+        const char *e = getenv("RECOMP_GL_MIPMAPS");
+        on = !(e && *e == '0');
+    }
+    return on;
+}
+
+static uint32_t mip_count(uint32_t w, uint32_t h)
+{
+    uint32_t n = 1, m = w > h ? w : h;
+    while (m > 1) { m >>= 1; n++; }
+    return n;
+}
+
+/* DXT textures go to the GPU compressed, with the title's own mip levels:
+ * no texel-by-texel decode on the executor (2-3 ms a texture, most of the
+ * stall when a race starts and its textures are first used).
+ * RECOMP_GL_DXT=0 decodes them like everything else. */
+static GLenum dxt_format(const NvGlTex *t)
+{
+    static int ok = -1;
+    if (ok < 0) {
+        const char *e = getenv("RECOMP_GL_DXT");
+        ok = !(e && *e == '0') && epoxy_has_gl_extension("GL_EXT_texture_compression_s3tc");
+        fprintf(stderr, "[GL] DXT textures %s\n", ok ? "uploaded compressed" : "decoded on the CPU");
+    }
+    if (!ok || t->palette || t->linear)
+        return 0;
+    switch (t->color) {
+    case 0x0C: return GL_COMPRESSED_RGBA_S3TC_DXT1_EXT;
+    case 0x0E: return GL_COMPRESSED_RGBA_S3TC_DXT3_EXT;
+    case 0x0F: return GL_COMPRESSED_RGBA_S3TC_DXT5_EXT;
+    }
+    return 0;
+}
+
+static uint32_t dxt_level_bytes(GLenum f, uint32_t w, uint32_t h)
+{
+    return ((w + 3) / 4) * ((h + 3) / 4) * (f == GL_COMPRESSED_RGBA_S3TC_DXT1_EXT ? 8u : 16u);
+}
+
+/* Whether level 1 in guest memory looks like level 0 shrunk: a texture the
+ * title builds at run time (Lamborghini's car paint, compressed by the CPU
+ * each race) leaves its smaller levels stale, and sampling those showed the
+ * roof yellow at a grazing angle. Compares block colours (endpoint means)
+ * at a grid of points; any texture failing it is decoded with GPU-made mips. */
+static void dxt_block_rgb(const uint8_t *blk, GLenum f, int rgb[3])
+{
+    const uint8_t *c = blk + (f == GL_COMPRESSED_RGBA_S3TC_DXT1_EXT ? 0 : 8);
+    uint32_t c0 = c[0] | (c[1] << 8), c1 = c[2] | (c[3] << 8);
+    rgb[0] = (int)((((c0 >> 11) & 31) + ((c1 >> 11) & 31)) * 255 / 62);
+    rgb[1] = (int)((((c0 >> 5) & 63) + ((c1 >> 5) & 63)) * 255 / 126);
+    rgb[2] = (int)(((c0 & 31) + (c1 & 31)) * 255 / 62);
+}
+
+static int dxt_mips_ok(const NvGlTex *t, GLenum f)
+{
+    const uint8_t *l0 = guest(t->offset), *l1;
+    uint32_t bb = f == GL_COMPRESSED_RGBA_S3TC_DXT1_EXT ? 8u : 16u;
+    uint32_t bw0 = (t->width + 3) / 4, bw1 = (t->width / 2 + 3) / 4, bh1 = (t->height / 2 + 3) / 4;
+    uint32_t gx, gy, n = 0;
+    long diff = 0;
+    if (t->width < 32 || t->height < 32)
+        return 1;
+    l1 = l0 + dxt_level_bytes(f, t->width, t->height);
+    for (gy = 0; gy < 8; gy++)
+        for (gx = 0; gx < 8; gx++) {
+            uint32_t bx = (gx * 2 + 1) * bw1 / 16, by = (gy * 2 + 1) * bh1 / 16, k, i;
+            int a[3], m[3] = {0, 0, 0};
+            dxt_block_rgb(l1 + ((size_t)by * bw1 + bx) * bb, f, a);
+            for (k = 0; k < 4; k++) {
+                int q[3];
+                uint32_t x0 = bx * 2 + (k & 1), y0 = by * 2 + (k >> 1);
+                dxt_block_rgb(l0 + ((size_t)y0 * bw0 + x0) * bb, f, q);
+                for (i = 0; i < 3; i++) m[i] += q[i];
+            }
+            for (i = 0; i < 3; i++)
+                diff += labs((long)a[i] - m[i] / 4);
+            n++;
+        }
+    return diff / (long)(n * 3) < 24;       /* mean channel difference */
+}
+
+/* Levels of the chain that fit in the bytes the texture declares (per face). */
+static uint32_t dxt_levels(const NvGlTex *t, GLenum f, uint32_t want)
+{
+    uint32_t faces = t->cube ? 6 : 1, per = faces > 1 && t->face_stride ? t->face_stride : t->bytes / faces;
+    uint32_t w = t->width, h = t->height, l, sum = 0;
+    for (l = 0; l < want; l++) {
+        sum += dxt_level_bytes(f, w, h);
+        if (per && sum > per)
+            break;
+        w = w > 1 ? w / 2 : 1; h = h > 1 ? h / 2 : 1;
+    }
+    return l ? l : 1;
+}
+
+static TexEnt s_tex[MAX_TEX];
+static uint32_t *s_decode_buf;
+static size_t s_decode_cap;
+
+/* 64 eight-byte samples spread over the texture: cheap enough to run every
+ * frame on every texture, and any wholesale rewrite (a video frame, a
+ * streamed texture) changes it. tex_get runs the full hash every 30 frames
+ * as well, for the rest. */
+static uint64_t tex_sparse(const NvGlTex *t)
+{
+    const uint8_t *p = guest(t->offset);
+    uint64_t h = 0x9E3779B97F4A7C15ull, w;
+    uint32_t k;
+    if (t->bytes < 8)
+        return hash_bytes(p, t->bytes);
+    for (k = 0; k < 64; k++) {
+        memcpy(&w, p + (size_t)(t->bytes - 8) * k / 63, 8);
+        h = (h ^ w) * 0x100000001B3ull;
+        h ^= h >> 29;
+    }
+    if (t->palette)
+        h ^= hash_bytes(guest(t->palette), 1024) * 31u;
+    return h;
+}
+
+static uint64_t tex_hash(const NvGlTex *t)
+{
+    uint64_t h = hash_bytes(guest(t->offset), t->bytes);
+    if (t->palette)
+        h ^= hash_bytes(guest(t->palette), 1024) * 31u;
+    return h;
+}
+
+static GLenum wrap_mode(uint32_t a, uint32_t border_color)
+{
+    switch (a) {
+    case 1: return GL_REPEAT;
+    case 2: return GL_MIRRORED_REPEAT;
+    case 4: return border_color ? GL_CLAMP_TO_BORDER : GL_CLAMP_TO_EDGE;
+    default: return GL_CLAMP_TO_EDGE;
+    }
+}
+
+/* The cached GL texture for a stage, decoded if new or changed. */
+/* Per-draw timers only under RECOMP_GPU_TIMING=1: a clock read costs
+ * tens of ns, and these ran several times a draw at 50k draws a second. */
+static inline uint64_t tnow(void)
+{
+    static int on = -1;
+    if (on < 0) {
+        const char *e = getenv("RECOMP_GPU_TIMING");
+        on = e && *e == '1';
+    }
+    return on ? xbox_HostNowNs() : 0;
+}
+static TexEnt *tex_get(const NvGlTex *t)
+{
+    int i, idx = -1, lru = 0;
+    TexEnt *e;
+    GLenum target = t->cube ? GL_TEXTURE_CUBE_MAP : GL_TEXTURE_2D;
+
+    if (!t->valid || !t->width || !t->height || !s_decode
+            || t->width > 4096 || t->height > 4096)
+        return NULL;
+    /* Decoding from guest memory: any surface drawn over it goes there
+     * first. (A surface sampled in place never gets here.) */
+    /* A cube map whose faces are render targets: copy them on the GPU. */
+    if (t->cube && t->face_stride) {
+        Surf *face[6];
+        uint32_t f, nf = 0;
+        for (f = 0; f < 6; f++) {
+            face[f] = NULL;
+            for (i = 0; i < MAX_SURF; i++) {
+                Surf *s = &s_surf[i];
+                if (s->tex && s->va == t->offset + f * t->face_stride && s->bpp == 4
+                        && s->swz && s->w == t->width && s->h == t->height
+                        && (t->color == 0x06 || t->color == 0x07)) {
+                    face[f] = s;
+                    nf++;
+                    break;
+                }
+            }
+        }
+        if (nf == 6) {
+            for (i = 0; i < MAX_TEX; i++)
+                if (s_tex[i].tex && s_tex[i].offset == t->offset && s_tex[i].cube
+                        && s_tex[i].w == t->width && s_tex[i].h == t->height
+                        && s_tex[i].color == t->color && s_tex[i].scaled == (SCALED))
+                    break;
+            if (i == MAX_TEX) {
+                int lru = 0;
+                for (i = 0; i < MAX_TEX; i++) {
+                    if (!s_tex[i].tex) { lru = i; break; }
+                    if (s_tex[i].used < s_tex[lru].used) lru = i;
+                }
+                i = lru;
+                if (s_tex[i].tex)
+                    glDeleteTextures(1, &s_tex[i].tex);
+                memset(&s_tex[i], 0, sizeof s_tex[i]);
+                s_tex[i].offset = t->offset; s_tex[i].color = t->color;
+                s_tex[i].w = t->width; s_tex[i].h = t->height; s_tex[i].cube = 1;
+                s_tex[i].pitch = t->pitch;
+                s_tex[i].levels = 1;
+                s_tex[i].scaled = SCALED;
+                glGenTextures(1, &s_tex[i].tex);
+                glBindTexture(GL_TEXTURE_CUBE_MAP, s_tex[i].tex);
+                glTexStorage2D(GL_TEXTURE_CUBE_MAP, 1, GL_RGBA8, SC(t->width), SC(t->height));
+            }
+            e = &s_tex[i];
+            for (f = 0; f < 6; f++)
+                face[f]->consumed = s_frame;
+            for (f = 0; f < 6; f++)
+                glCopyImageSubData(face[f]->tex, GL_TEXTURE_2D, 0, 0, 0, 0,
+                                   e->tex, GL_TEXTURE_CUBE_MAP, 0, 0, 0, (GLint)f,
+                                   SCX(face[f], t->width), SC(t->height), 1);
+            /* Guest memory is what a later decode would compare against;
+             * never let a stale hash claim this texture is current. */
+            e->checked_epoch = 0;
+            e->hash = 0;
+            e->used = s_use_clock;
+            G.cube_copies++;
+            return e;
+        }
+    }
+    s_rb_why = 2;
+    {
+        uint64_t before = G.rb_why[2];
+        sync_range(t->offset, (uint64_t)t->offset + t->bytes, -1);
+        if (G.rb_why[2] != before) {
+            G.last_tex_color = t->color; G.last_tex_w = t->width;
+            G.last_tex_h = t->height; G.last_tex_cube = t->cube;
+        }
+    }
+    for (i = 0; i < MAX_TEX; i++) {
+        e = &s_tex[i];
+        if (e->tex && e->offset == t->offset && e->color == t->color
+                && e->w == t->width && e->h == t->height && e->pitch == t->pitch
+                && e->cube == t->cube && e->palette == t->palette && !e->scaled) {
+            idx = i;
+            break;
+        }
+        if (!e->tex) { if (s_tex[lru].tex) lru = i; }
+        else if (s_tex[lru].tex && e->used < s_tex[lru].used) lru = i;
+    }
+    if (idx >= 0) {
+        e = &s_tex[idx];
+        if (e->checked_epoch != s_epoch) {
+            uint64_t t0 = tnow();
+            uint64_t sp = tex_sparse(t), h;
+            e->checked_epoch = s_epoch;
+            /* A full hash every frame a texture is used: a title reloading
+             * a texture in place (a loading screen, the menus after a race)
+             * can change bytes the sparse probe misses, and the stale
+             * decode showed as garbage. The sparse probe stays as a
+             * shortcut only under RECOMP_GL_SPARSE_TEX=1. */
+            /* Default: a full hash every 8 epochs per texture, staggered by
+             * slot so the cost spreads over frames; the sampled probe in
+             * between catches most rewrites at once. RECOMP_GL_SPARSE_TEX=0
+             * hashes everything every frame (slow), =1 every 30 epochs. */
+            static int every = -1;
+            if (every < 0) {
+                const char *e2 = getenv("RECOMP_GL_SPARSE_TEX");
+                every = !e2 ? 8 : *e2 == '0' ? 1 : 30;
+            }
+            if (sp == e->sparse && s_epoch - e->full_epoch < (uint32_t)every
+                    && ((s_epoch + (uint32_t)idx) % (uint32_t)every) != 0) {
+                G.sparse_hits++;
+                G.ns_hash += tnow() - t0;
+                e->used = s_use_clock;
+                return e;
+            }
+            h = tex_hash(t);
+            e->full_epoch = s_epoch;
+            e->sparse = sp;
+            G.ns_hash += tnow() - t0;
+            if (h == e->hash) {
+                e->used = s_use_clock;
+                return e;
+            }
+            e->hash = h;
+        } else {
+            e->used = s_use_clock;
+            return e;
+        }
+    } else {
+        idx = lru;
+        e = &s_tex[idx];
+        if (e->tex)
+            glDeleteTextures(1, &e->tex);
+        memset(e, 0, sizeof *e);
+        e->offset = t->offset; e->color = t->color; e->w = t->width;
+        e->h = t->height; e->pitch = t->pitch; e->cube = t->cube;
+        e->palette = t->palette;
+        e->hash = tex_hash(t);
+        e->sparse = tex_sparse(t);
+        e->checked_epoch = e->full_epoch = s_epoch;
+        glGenTextures(1, &e->tex);
+        glBindTexture(target, e->tex);
+        e->levels = (mips_on() && t->levels > 1 && !t->linear)
+                  ? mip_count(t->width, t->height) : 1;
+        e->dxt = dxt_format(t);
+        if (e->dxt && e->levels > 1 && !dxt_mips_ok(t, e->dxt)) {
+            static unsigned shown;
+            if (shown++ < 16)
+                fprintf(stderr, "[GL] DXT %08X %ux%u: stale mip levels, decoded instead\n",
+                        t->offset, t->width, t->height);
+            e->dxt = 0;                     /* decoded, mips made on the GPU */
+        }
+        if (e->dxt) {
+            uint32_t want = e->levels > 1 ? (t->levels < e->levels ? t->levels : e->levels) : 1;
+            e->levels = dxt_levels(t, e->dxt, want);
+        }
+        glTexStorage2D(target, (GLsizei)e->levels, e->dxt ? e->dxt : GL_RGBA8,
+                       t->width, t->height);
+    }
+    /* (Re)decode. */
+    G.decodes++;
+    if (e->dxt && e->levels > 1 && !dxt_mips_ok(t, e->dxt)) {
+        /* Rewritten in place with stale small levels: decoded from now on. */
+        GLenum tg = t->cube ? GL_TEXTURE_CUBE_MAP : GL_TEXTURE_2D;
+        glDeleteTextures(1, &e->tex);
+        glGenTextures(1, &e->tex);
+        glBindTexture(tg, e->tex);
+        e->dxt = 0;
+        e->levels = mip_count(t->width, t->height);
+        e->params_set = 0;
+        glTexStorage2D(tg, (GLsizei)e->levels, GL_RGBA8, t->width, t->height);
+    }
+    if (e->dxt) {
+        const uint8_t *base = guest(t->offset);
+        uint32_t f, faces = t->cube ? 6 : 1, l;
+        uint64_t t0 = tnow();
+        glBindTexture(target, e->tex);
+        glPixelStorei(GL_UNPACK_ROW_LENGTH, 0);
+        for (f = 0; f < faces; f++) {
+            const uint8_t *p = base + (size_t)f * t->face_stride;
+            uint32_t w = t->width, h = t->height;
+            for (l = 0; l < e->levels; l++) {
+                uint32_t n = dxt_level_bytes(e->dxt, w, h);
+                glCompressedTexSubImage2D(t->cube ? GL_TEXTURE_CUBE_MAP_POSITIVE_X + f : GL_TEXTURE_2D,
+                                          (GLint)l, 0, 0, (GLsizei)w, (GLsizei)h, e->dxt,
+                                          (GLsizei)n, p);
+                p += n;
+                w = w > 1 ? w / 2 : 1; h = h > 1 ? h / 2 : 1;
+            }
+        }
+        G.ns_decode += tnow() - t0;
+        e->used = s_use_clock;
+        return e;
+    }
+    {
+        uint64_t t0 = tnow();
+        size_t need = (size_t)t->width * t->height;
+        uint32_t f, faces = t->cube ? 6 : 1;
+        if (need > s_decode_cap) {
+            free(s_decode_buf);
+            s_decode_buf = (uint32_t *)malloc(need * 4);
+            s_decode_cap = s_decode_buf ? need : 0;
+            if (!s_decode_buf)
+                return NULL;
+        }
+        glBindTexture(target, e->tex);
+        glPixelStorei(GL_UNPACK_ROW_LENGTH, 0);
+        for (f = 0; f < faces; f++) {
+            if (!s_decode(t, f, s_decode_buf))
+                memset(s_decode_buf, 0xFF, need * 4);
+            glTexSubImage2D(t->cube ? GL_TEXTURE_CUBE_MAP_POSITIVE_X + f : GL_TEXTURE_2D,
+                            0, 0, 0, t->width, t->height, GL_BGRA,
+                            GL_UNSIGNED_INT_8_8_8_8_REV, s_decode_buf);
+            {   /* RECOMP_GL_DUMPTEX=<hex guest VA>: write that texture's
+                 * decode (face 0) as <VA>_<w>x<h>.bgra next to the binary. */
+                static uint32_t want = 1;
+                if (want == 1) {
+                    const char *e2 = getenv("RECOMP_GL_DUMPTEX");
+                    want = e2 ? (uint32_t)strtoul(e2, NULL, 16) : 0;
+                }
+                if (want && t->offset == want && f == 0) {
+                    char name[64];
+                    FILE *df;
+                    snprintf(name, sizeof name, "%08X_%ux%u.bgra", want, t->width, t->height);
+                    df = fopen(name, "wb");
+                    if (df) {
+                        fwrite(s_decode_buf, 4, need, df);
+                        fclose(df);
+                    }
+                    fprintf(stderr, "[GL] dumped texture %08X fmt %02X %ux%u pitch %u bytes %u\n",
+                            want, t->color, t->width, t->height, t->pitch, t->bytes);
+                }
+            }
+        }
+        if (e->levels > 1)
+            glGenerateMipmap(target);
+        G.ns_decode += tnow() - t0;
+    }
+    e->used = s_use_clock;
+    return e;
+}
+
+static void tex_bind(int stage, const NvGlTex *t, TexEnt *e)
+{
+    GLenum target = t->cube ? GL_TEXTURE_CUBE_MAP : GL_TEXTURE_2D;
+    glActiveTexture(GL_TEXTURE0 + (t->cube ? 4 + stage : stage));
+    glBindTexture(target, e->tex);
+    if (!e->params_set || e->addr_u != t->addr_u || e->addr_v != t->addr_v
+            || e->filter != t->filter || e->border != t->border
+            || e->border_color != t->border_color) {
+        /* TENT (bilinear) exactly when the software sampler uses it. */
+        uint32_t mag = (t->filter >> 24) & 0xF, min = (t->filter >> 16) & 0xFF;
+        GLint f = (mag == 2 || min == 2 || min == 4 || min == 6) ? GL_LINEAR : GL_NEAREST;
+        GLint fmin = f;
+        float bc[4];
+        if (e->levels > 1) {
+            /* NV2A MIN: 3 box/box-mip, 4 tent/box-mip, 5 box/tent-mip,
+             * 6 tent/tent-mip (GL's order). */
+            switch (min) {
+            case 3: fmin = GL_NEAREST_MIPMAP_NEAREST; break;
+            case 4: fmin = GL_LINEAR_MIPMAP_NEAREST; break;
+            case 5: fmin = GL_NEAREST_MIPMAP_LINEAR; break;
+            case 6: fmin = GL_LINEAR_MIPMAP_LINEAR; break;
+            default: break;
+            }
+        }
+        glTexParameteri(target, GL_TEXTURE_MIN_FILTER, fmin);
+        glTexParameteri(target, GL_TEXTURE_MAG_FILTER, (mag == 2 || min == 2 || min == 4 || min == 6) ? GL_LINEAR : GL_NEAREST);
+        glTexParameteri(target, GL_TEXTURE_WRAP_S, wrap_mode(t->addr_u, t->border_color));
+        glTexParameteri(target, GL_TEXTURE_WRAP_T, wrap_mode(t->addr_v, t->border_color));
+        glTexParameteri(target, GL_TEXTURE_WRAP_R, GL_CLAMP_TO_EDGE);
+        unpack_argb(t->border, bc);
+        glTexParameterfv(target, GL_TEXTURE_BORDER_COLOR, bc);
+        e->addr_u = t->addr_u; e->addr_v = t->addr_v; e->filter = t->filter;
+        e->border = t->border; e->border_color = t->border_color;
+        e->params_set = 1;
+    }
+}
+
+/* ── Drawing ─────────────────────────────────────────────────────────── */
+
+/* RECOMP_GL_CULL=0: draw back faces too (the state before culling was
+ * modelled). */
+static int s_cull_on = -1;
+
+static void apply_raster_state(const NvGlState *st)
+{
+    /* Face culling. Positions reach GL with screen y unflipped, so the
+     * title's clockwise (on a y-down screen) is GL's counter-clockwise. */
+    if (s_cull_on < 0) {
+        const char *e = getenv("RECOMP_GL_CULL");
+        s_cull_on = !(e && *e == '0');
+    }
+    if (s_cull_on && st->cull_enable
+            && (st->cull_face == 0x404 || st->cull_face == 0x405 || st->cull_face == 0x408)) {
+        glEnable(GL_CULL_FACE);
+        glCullFace(st->cull_face);
+        glFrontFace(st->front_face == 0x901 ? GL_CW : GL_CCW);
+    } else {
+        glDisable(GL_CULL_FACE);
+    }
+    /* Depth: GL only writes depth with the test on, so a write without a
+     * test is a test that always passes. */
+    if (st->depth_test || st->depth_mask) {
+        glEnable(GL_DEPTH_TEST);
+        glDepthFunc(st->depth_test ? st->depth_func : GL_ALWAYS);
+    } else {
+        glDisable(GL_DEPTH_TEST);
+    }
+    glDepthMask(st->depth_mask ? GL_TRUE : GL_FALSE);
+    /* Stencil: a title marks pixels (Lamborghini: the wet road) and later
+     * passes draw only where the mark is (the road's reflection). */
+    if (st->stencil_test && st->zeta_key) {
+        GLenum f = st->stencil_func >= 0x200 && st->stencil_func <= 0x207
+                 ? st->stencil_func : GL_ALWAYS;
+        glEnable(GL_STENCIL_TEST);
+        glStencilFunc(f, (GLint)(st->stencil_ref & 0xFF), st->stencil_func_mask & 0xFF);
+        glStencilOp(st->stencil_fail, st->stencil_zfail, st->stencil_zpass);
+        glStencilMask(st->stencil_write_mask & 0xFF);
+    } else {
+        glDisable(GL_STENCIL_TEST);
+    }
+    glColorMask((st->color_mask & 0x00010000u) != 0, (st->color_mask & 0x00000100u) != 0,
+                (st->color_mask & 0x00000001u) != 0,
+                st->bpp == 4 && (st->color_mask & 0x01000000u) != 0);
+    if (st->blend_enable && !(st->blend_src == 1 && st->blend_dst == 0)) {
+        float bc[4];
+        GLenum eq = st->blend_eq;
+        if (eq != GL_FUNC_SUBTRACT && eq != GL_FUNC_REVERSE_SUBTRACT
+                && eq != GL_MIN && eq != GL_MAX)
+            eq = GL_FUNC_ADD;
+        glEnable(GL_BLEND);
+        glBlendFunc(st->blend_src, st->blend_dst);
+        glBlendEquation(eq);
+        unpack_argb(st->blend_color, bc);
+        glBlendColor(bc[0], bc[1], bc[2], bc[3]);
+    } else {
+        glDisable(GL_BLEND);
+    }
+}
+
+/* Everything a draw sets up before its vertices: the surface, depth,
+ * raster state, the program (vsh: the vertex-program interpreter) and its
+ * uniforms, and the textures. */
+static Surf *draw_setup(const NvGlState *st, int points, int vsh)
+{
+    Surf *s;
+    int i;
+    GLuint u4[4][8];
+    GLfloat f4[2][8][4];
+    float scale[4][2];
+    GLint valid[4] = {0, 0, 0, 0}, cubef[4] = {0, 0, 0, 0};
+
+    Up = vsh ? &U_vsh : &U_cpu;
+    s = surf_bind(st);
+    zbuf_attach(st->zeta_key, st->depth_test || st->depth_mask || st->stencil_test);
+    glViewport(0, 0, SCX(s, s->w), SC(s->h));
+    glScissor(SCX(s, st->sc_x), SC(st->sc_y), SCXW(s, st->sc_x, st->sc_w), SCW(st->sc_y, st->sc_h));
+    apply_raster_state(st);
+
+    glUseProgram(vsh ? s_prog_vsh : s_prog);
+    glUniform2f(U.size, (float)s->w, (float)s->h);
+    glUniform1f(U.zscale, st->zmax > 0.0f ? 1.0f / st->zmax : 1.0f / 16777215.0f);
+    glUniform1i(U.z01, s_z01);
+    glUniform1i(U.mode, points ? 2 : st->use_rc ? 0 : 1);
+    glUniform1i(U.textured, st->textured ? 1 : 0);
+
+    /* Textures: every stage the combiners read, or stage 0 without them. */
+    for (i = 0; i < 4; i++) {
+        const NvGlTex *t = &st->tex[i];
+        int needed = points ? 0
+                   : st->use_rc ? ((st->rc.stage_program >> (i * 5)) & 0x1F) != 0
+                   : (i == 0 && st->textured);
+        scale[i][0] = scale[i][1] = 1.0f;
+        if (needed && t->valid) {
+            int opaque = 0;
+            Surf *rt = surf_as_texture(t, &opaque);
+            TexEnt *e;
+            GLuint rt_tex = rt ? rt->tex : 0;
+            if (rt && rt == s) {
+                /* The surface being drawn, sampled (Lamborghini's glow and
+                 * heat-haze passes). The console reads what is in memory
+                 * from before this draw; a GPU copy gives the same without
+                 * the round trip through guest memory (a readback and a
+                 * re-decode per pass, a third of the frame on Black Forest). */
+                if (!self_tex[i] || self_w[i] != rt->w || self_h[i] != rt->h) {
+                    if (self_tex[i])
+                        glDeleteTextures(1, &self_tex[i]);
+                    glGenTextures(1, &self_tex[i]);
+                    glBindTexture(GL_TEXTURE_2D, self_tex[i]);
+                    glTexStorage2D(GL_TEXTURE_2D, 1, GL_RGBA8, SCX(rt, rt->w), SC(rt->h));
+                    self_w[i] = rt->w; self_h[i] = rt->h;
+                }
+                glCopyImageSubData(rt->tex, GL_TEXTURE_2D, 0, 0, 0, 0,
+                                   self_tex[i], GL_TEXTURE_2D, 0, 0, 0, 0,
+                                   SCX(rt, rt->w), SC(rt->h), 1);
+                rt_tex = self_tex[i];
+                G.self_copies++;
+            }
+            if (rt) {
+                /* A render target sampled where it lies, without a trip
+                 * through guest memory. */
+                uint32_t mag = (t->filter >> 24) & 0xF, min = (t->filter >> 16) & 0xFF;
+                GLint f = (mag == 2 || min == 2 || min == 4 || min == 6) ? GL_LINEAR : GL_NEAREST;
+                float bc[4];
+                glActiveTexture(GL_TEXTURE0 + i);
+                glBindTexture(GL_TEXTURE_2D, rt_tex);
+                glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, f);
+                glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, f);
+                glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, wrap_mode(t->addr_u, t->border_color));
+                glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, wrap_mode(t->addr_v, t->border_color));
+                glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_SWIZZLE_A, opaque ? GL_ONE : GL_ALPHA);
+                unpack_argb(t->border, bc);
+                glTexParameterfv(GL_TEXTURE_2D, GL_TEXTURE_BORDER_COLOR, bc);
+                valid[i] = 1;
+                if (t->linear) {
+                    scale[i][0] = 1.0f / (float)rt->w;
+                    scale[i][1] = 1.0f / (float)rt->h;
+                }
+                G.rt_samples++;
+                rt->consumed = s_frame;
+                continue;
+            }
+            e = tex_get(t);
+            if (e) {
+                tex_bind(i, t, e);
+                valid[i] = 1;
+                cubef[i] = t->cube ? 1 : 0;
+                if (t->linear) {
+                    scale[i][0] = 1.0f / (float)t->width;
+                    scale[i][1] = 1.0f / (float)t->height;
+                }
+            }
+        }
+    }
+    glUniform2fv(U.texscale, 4, &scale[0][0]);
+    glUniform1iv(U.texvalid, 4, valid);
+    glUniform1iv(U.texcubeflag, 4, cubef);
+
+    if (st->use_rc && !points) {
+        for (i = 0; i < 8; i++) {
+            u4[0][i] = st->rc.color_icw[i]; u4[1][i] = st->rc.alpha_icw[i];
+            u4[2][i] = st->rc.color_ocw[i]; u4[3][i] = st->rc.alpha_ocw[i];
+            unpack_argb(st->rc.factor0[i], f4[0][i]);
+            unpack_argb(st->rc.factor1[i], f4[1][i]);
+        }
+        glUniform1uiv(U.cicw, 8, u4[0]); glUniform1uiv(U.aicw, 8, u4[1]);
+        glUniform1uiv(U.cocw, 8, u4[2]); glUniform1uiv(U.aocw, 8, u4[3]);
+        glUniform4fv(U.f0, 8, &f4[0][0][0]); glUniform4fv(U.f1, 8, &f4[1][0][0]);
+        glUniform1ui(U.final0, st->rc.final0); glUniform1ui(U.final1, st->rc.final1);
+        {
+            float c0[4], c1[4];
+            unpack_argb(st->rc.final_c0, c0);
+            unpack_argb(st->rc.final_c1, c1);
+            glUniform4fv(U.fc0, 1, c0);
+            glUniform4fv(U.fc1, 1, c1);
+        }
+        glUniform1ui(U.control, st->rc.control);
+        glUniform1ui(U.stageprog, st->rc.stage_program);
+        {
+            float bm[4][4], bl[4][2];
+            for (i = 0; i < 4; i++) {
+                memcpy(bm[i], st->tex[i].bump_mat, sizeof bm[i]);
+                bl[i][0] = st->tex[i].bump_scale;
+                bl[i][1] = st->tex[i].bump_offset;
+            }
+            glUniform4fv(U.bumpmat, 4, &bm[0][0]);
+            glUniform2fv(U.bumplum, 4, &bl[0][0]);
+            glUniform1ui(U.otherin, st->other_stage_input);
+            glUniform1ui(U.dotmap, st->dot_mapping);
+            glUniform3fv(U.eye, 1, st->eye);
+            glUniform1i(U.dbgview, st->depth_test ? nv2a_gl_debug_view : 0);
+        }
+        glUniform1ui(U.clipmode, st->clip_plane_mode);
+        glUniform4fv(U.fogcolor, 1, st->fog_color);
+    }
+    glUniform1i(U.atest, st->alpha_test ? 1 : 0);
+    glUniform1ui(U.afunc, st->alpha_func);
+    glUniform1i(U.aref, (int)(st->alpha_ref & 0xFF));
+
+    return s;
+}
+
+/* Widescreen HUD: a 2D draw (flat) onto the screen keeps its shape. The
+ * frame is stretched by s_stretch for the screen, so such a draw is squeezed
+ * by the same amount about the screen's centre: HUD and menus sit in the
+ * middle 4:3, the 3D around them fills the width. The squeeze is the same
+ * linear map for every vertex, so text batched across the whole screen in
+ * one draw keeps together. A single rectangle (nearly) as wide as the
+ * screen -- menu backgrounds, full-screen effects and fades, divider lines
+ * -- stays full width. RECOMP_WIDE_HUD=0 stretches everything. */
+int nv2a_gl_hud_active(void)
+{
+    static int on = -1;
+    if (on < 0) {
+        const char *e = getenv("RECOMP_WIDE_HUD");
+        on = !(e && *e == '0');
+    }
+    return on && s_stretch > 100;
+}
+
+float g_hud_w0;
+static const NvGlState *s_hud_st;
+/* A 2D draw's vertices share one small w (the title's screen-space quads use
+ * 1 or 2); 3D billboards with a constant w are far beyond 8 units. */
+int nv2a_flat_w(float w) { return w >= 0.25f && w <= 8.0f; }
+#define s_hud_w0 g_hud_w0
+/* HUD at the screen edges (F1; 0 = centred): in a race, the HUD's 2D
+ * triangles in the left third of the 4:3 layout keep their distance from
+ * the left edge of the wide screen, those in the right third from the right
+ * edge; the rest (mirror, bumper-view dials, countdown) stay centred. A
+ * race starts with a frame of many 3D draws (150 or more) and ends after a
+ * second of frames with few (under 60: menus, the pause screen), so a
+ * simpler view in a race does not drop the HUD back to the centre. */
+static int s_hud_edges;
+static int s_race;              /* in a race (see above), from the last frames */
+static int s_hud_trace_now;
+static uint32_t s_draws3d_prev;
+/* Edges for this draw: off over a menu. The pause menu is drawn over the
+ * still-rendered race (so s_race stays on) and lays its items out in an arc
+ * across the left of the screen, which edge placement tore apart. Menus
+ * draw full-width divider lines (one 2-triangle quad, 640 wide); the race
+ * HUD never does. Seen this frame or the last: a menu is up. */
+static int s_edges_now;
+void nv2a_gl_set_hud_edges(int on) { s_hud_edges = on != 0; }
+
+/* Returns 1 when the draw was squeezed as part of the centred 2D layout. */
+static int hud_uniform(const Surf *s, int flat, float minx, float maxx, uint32_t n)
+{
+    float k = 1.0f, b = 0.0f;
+    int squeezed = 0;
+    {   /* RECOMP_HUD_TRACE=s: every draw of the frame s seconds in, and how it was classified */
+        static long tf = -2;
+        if (tf == -2) { const char *e = getenv("RECOMP_HUD_TRACE"); tf = e ? atol(e) : -1; }
+        static uint64_t t0; static long fr = -1;
+        if (!t0) t0 = xbox_HostNowNs();
+        if (tf >= 0 && fr < 0 && (long)((xbox_HostNowNs() - t0) / 1000000000ull) >= tf) fr = (long)s_frame;
+        s_hud_trace_now = fr >= 0 && (long)s_frame == fr;
+        if (s_hud_trace_now)
+            fprintf(stderr, "[HUDT] surf %ux%u flat %d n %u x %.1f..%.1f w0 %g t0 %08X %ux%u fmt %02X lin %u\n", s->w, s->h, flat, n, minx, maxx, s_hud_w0,
+                    s_hud_st && s_hud_st->tex[0].valid ? s_hud_st->tex[0].offset : 0, s_hud_st ? s_hud_st->tex[0].width : 0,
+                    s_hud_st ? s_hud_st->tex[0].height : 0, s_hud_st ? (s_hud_st->tex[0].color >> 8) & 0xFF : 0, s_hud_st ? s_hud_st->tex[0].linear : 0);
+    }
+    /* Draws onto the screen this frame and the last: a frame of (almost)
+     * nothing but one full-screen picture is a video or a still (intro
+     * movies, logos), which keeps its 4:3 shape with bars at the sides. In
+     * menus the animated backgrounds are full-screen too, under many other
+     * draws; those stay full width. */
+    static uint32_t frame_seen, draws_now, draws_prev, d3_now, d3_low;
+    static int menu_now, menu_prev;
+    int screen = s->w == 640 && s->h >= 480, lone = 0;
+    if (screen) {
+        if (frame_seen != s_frame) {
+            int next = frame_seen + 1 == s_frame;
+            draws_prev = next ? draws_now : 0;
+            s_draws3d_prev = next ? d3_now : 0;
+            if (s_draws3d_prev >= 150) {
+                s_race = 1;
+                d3_low = 0;
+            } else if (s_draws3d_prev < 60 && ++d3_low >= 60) {
+                s_race = 0;
+            }
+            {   /* RECOMP_HUD_D3=1: the count once a second */
+                static int on = -1; static uint64_t last;
+                if (on < 0) { const char *e = getenv("RECOMP_HUD_D3"); on = e && *e == '1'; }
+                if (on && xbox_HostNowNs() - last > 1000000000ull) {
+                    last = xbox_HostNowNs();
+                    fprintf(stderr, "[HUDD] d3prev %u draws %u race %d\n", s_draws3d_prev, draws_prev, s_race);
+                }
+            }
+            menu_prev = next ? menu_now : 0;
+            draws_now = d3_now = 0;
+            menu_now = 0;
+            frame_seen = s_frame;
+        }
+        draws_now++;
+        if (!flat)
+            d3_now++;
+        else if (n == 6 && maxx - minx >= 600.0f)
+            menu_now = 1;
+        lone = draws_prev && draws_prev <= 12;
+    }
+    /* A draw clipped to a window narrower than the screen (the mirror) is
+     * laid out with the HUD: squeezed with it, 3D or not. */
+    int windowed = s_hud_st && s_hud_st->sc_w < 600;
+    if (nv2a_gl_hud_active() && screen
+            && ((flat && (lone || !(n <= 6 && maxx - minx >= 600.0f))) || windowed)) {
+        k = 100.0f / (float)s_stretch;
+        b = 320.0f * (1.0f - k);
+        G.hud_draws++;
+        squeezed = !windowed;
+        if (windowed) {   /* the window's clip moves with it */
+            const NvGlState *st = s_hud_st;
+            uint32_t x0 = (uint32_t)(st->sc_x * k + b + 0.5f);
+            uint32_t x1 = (uint32_t)((st->sc_x + st->sc_w) * k + b + 0.5f);
+            glScissor(SCX(s, x0), SC(st->sc_y), SCXW(s, x0, x1 - x0), SCW(st->sc_y, st->sc_h));
+        }
+    }
+    s_edges_now = s_hud_edges && s_race && !menu_now && !menu_prev;
+    if (squeezed && !lone && s_edges_now) {
+        /* HUD at the edges, a whole draw at a time (the vertex-program
+         * path: one element per draw); the CPU path refines per triangle. */
+        if (maxx <= 640.0f / 3.0f)
+            b = 0.0f;
+        else if (minx >= 1280.0f / 3.0f)
+            b = 640.0f * (1.0f - k);
+    }
+    if (getenv("RECOMP_HUD_TRACE") && s_hud_trace_now)
+        fprintf(stderr, "[HUDT]   -> k %.3f b %.1f squeezed %d lone %d d3prev %u edges %d\n", k, b, squeezed, lone, s_draws3d_prev, s_edges_now);
+    glUniform2f(U.hud, k, b);
+    return squeezed && !lone;
+}
+
+/* Visibility reports (below): draws while the pixel counter is on. */
+static int s_zpass_on;                  /* tentative; defined with the reports */
+static int s_cnt_draws;                 /* draws while counting, since CLEAR */
+
+void nv2a_gl_draw(const NvGlState *st, const NvGlVertex *v, uint32_t n, int points)
+{
+    Surf *s;
+    uint64_t t0;
+
+    if (!n || !nv2a_gl_enabled() || (st->bpp != 2 && st->bpp != 4))
+        return;
+    if (s_zpass_on)
+        s_cnt_draws++;
+    t0 = tnow();
+    G.draws++;
+    G.verts += n;
+    s = draw_setup(st, points, 0);
+    s_hud_st = st;
+    {   /* flat: every vertex at w 1 */
+        uint32_t j;
+        float mn = 1e30f, mx = -1e30f;
+        int flat = nv2a_gl_hud_active();
+        float w0 = v[0].pos[3];
+        s_hud_w0 = w0;
+        if (!nv2a_flat_w(w0)) flat = 0;
+        for (j = 0; j < n && flat; j++) {
+            if (fabsf(v[j].pos[3] - w0) > 1e-4f * w0) flat = 0;
+            if (v[j].pos[0] < mn) mn = v[j].pos[0];
+            if (v[j].pos[0] > mx) mx = v[j].pos[0];
+        }
+        if (hud_uniform(s, flat, mn, mx, n) && s_edges_now && !points && n % 3 == 0) {
+            /* HUD at the edges: placed per triangle on the CPU, then drawn
+             * with no further squeeze. */
+            static NvGlVertex *tmp;
+            static uint32_t cap;
+            float k = 100.0f / (float)s_stretch, b = 320.0f * (1.0f - k);
+            if (cap < n) {
+                NvGlVertex *t = (NvGlVertex *)realloc(tmp, n * sizeof *t);
+                if (t) { tmp = t; cap = n; }
+            }
+            if (cap >= n) {
+                memcpy(tmp, v, n * sizeof *tmp);
+                for (j = 0; j < n; j += 3) {
+                    float t0x = tmp[j].pos[0], t1x = tmp[j + 1].pos[0], t2x = tmp[j + 2].pos[0];
+                    float lo = fminf(t0x, fminf(t1x, t2x)), hi = fmaxf(t0x, fmaxf(t1x, t2x));
+                    int z = hi <= 640.0f / 3.0f ? 0 : lo >= 1280.0f / 3.0f ? 2 : 1;
+                    int q;
+                    for (q = 0; q < 3; q++) {
+                        float *x = &tmp[j + q].pos[0];
+                        *x = z == 0 ? *x * k : z == 2 ? 640.0f - (640.0f - *x) * k : *x * k + b;
+                    }
+                }
+                glUniform2f(U.hud, 1.0f, 0.0f);
+                v = tmp;
+            }
+        }
+    }
+    glBindVertexArray(s_vao);
+    glBindBuffer(GL_ARRAY_BUFFER, s_vbo);
+    glBufferData(GL_ARRAY_BUFFER, (GLsizeiptr)(n * sizeof(NvGlVertex)), v, GL_STREAM_DRAW);
+    glDrawArrays(points ? GL_POINTS : GL_TRIANGLES, 0, (GLsizei)n);
+    if (st->color_mask & 0x01010101u)
+        s->dirty = 1;
+    G.ns_draw += tnow() - t0;
+}
+
+int nv2a_gl_vsh_available(void)
+{
+    static int on = -1;
+    if (on < 0) {
+        const char *e = getenv("RECOMP_GPU_VSH");
+        on = !(e && *e == '0');
+    }
+    return on && nv2a_gl_enabled() && s_prog_vsh != 0;
+}
+
+/* A vertex-program batch: the program runs here, on the GPU. */
+/* Lines keep their on-screen thickness at internal resolutions above 1x:
+ * the NV2A draws them one guest pixel wide, so they get the render scale
+ * (a 1-pixel streak at 3x would be a third as thick as on hardware).
+ * RECOMP_GL_LINE_WIDTH=<w> overrides the width in guest pixels. */
+static void vsh_line_width(GLenum mode, int on)
+{
+    static float guest_w = -1.0f;
+    float w;
+
+    if (mode != GL_LINES && mode != GL_LINE_STRIP && mode != GL_LINE_LOOP)
+        return;
+    if (guest_w < 0.0f) {
+        const char *e = getenv("RECOMP_GL_LINE_WIDTH");
+        guest_w = e ? (float)atof(e) : 1.0f;
+        if (guest_w <= 0.0f) guest_w = 1.0f;
+    }
+    w = on ? guest_w * (float)s_scale / 100.0f : 1.0f;
+    glLineWidth(w < 1.0f ? 1.0f : w);
+}
+
+void nv2a_gl_draw_vsh(const NvGlState *st, const NvGlVshBatch *b)
+{
+    Surf *s;
+    uint64_t t0;
+    int i;
+
+    if (!b->nidx || !b->nverts || !nv2a_gl_vsh_available()
+            || (st->bpp != 2 && st->bpp != 4))
+        return;
+    if (s_zpass_on)
+        s_cnt_draws++;
+    t0 = tnow();
+    G.draws++;
+    G.verts += b->nidx;
+    G.vsh_draws++;
+    s = draw_setup(st, 0, 1);
+    s_hud_st = st;
+    hud_uniform(s, b->flat, b->flat_minx, b->flat_maxx, b->flat_n);
+    { uint64_t t1 = tnow(); G.ns_setup += t1 - t0; }
+    if (b->prog_gen != s_vsh_prog_gen) {
+        glUniform4uiv(U.vprog, (GLsizei)(b->nins * 2), &b->prog[0][0]);
+        glUniform1i(U.vnins, (GLint)b->nins);
+        s_vsh_prog_gen = b->prog_gen;
+    }
+    if (b->const_gen != s_vsh_const_gen) {
+        glUniform4fv(U.vconst, 192, b->consts);
+        s_vsh_const_gen = b->const_gen;
+    }
+    glUniform2f(U.aa, b->aa_sx, b->aa_sy);
+    glUniform1f(U.near, b->near_z);
+    glUniform2f(U.fogp, b->fog_p[0], b->fog_p[1]);
+    glUniform2i(U.fogmode, (GLint)b->fog_enable, (GLint)b->fog_mode);
+
+    glBindVertexArray(s_vao_vsh);
+    glBindBuffer(GL_ARRAY_BUFFER, s_vbo_vsh);
+    if (b->raw) {
+        GLuint packed = 0;
+        glBufferData(GL_ARRAY_BUFFER, (GLsizeiptr)b->attr_bytes, b->attrs, GL_STREAM_DRAW);
+        for (i = 0; i < 16; i++) {
+            const void *at = (const void *)(uintptr_t)b->off[i];
+            GLsizei st2 = (GLsizei)b->stride[i];
+            GLint n = b->size[i] > 4 ? 4 : b->size[i];
+            if (b->slot[i] < 0) {
+                glDisableVertexAttribArray((GLuint)i);
+                glVertexAttrib4fv((GLuint)i, b->konst[i]);
+                continue;
+            }
+            glEnableVertexAttribArray((GLuint)i);
+            switch (b->type[i]) {
+            case 0:  glVertexAttribPointer((GLuint)i, GL_BGRA, GL_UNSIGNED_BYTE, GL_TRUE, st2, at); break;
+            case 1:  glVertexAttribPointer((GLuint)i, n, GL_SHORT, GL_TRUE, st2, at); break;
+            case 4:  glVertexAttribPointer((GLuint)i, n, GL_UNSIGNED_BYTE, GL_TRUE, st2, at); break;
+            case 5:  glVertexAttribPointer((GLuint)i, n, GL_SHORT, GL_FALSE, st2, at); break;
+            case 6:  glVertexAttribPointer((GLuint)i, 1, GL_FLOAT, GL_FALSE, st2, at);
+                     packed |= 1u << i; break;
+            default: glVertexAttribPointer((GLuint)i, n, GL_FLOAT, GL_FALSE, st2, at); break;
+            }
+        }
+        glUniform1ui(U.packed, packed);
+        glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, s_ibo_vsh);
+        glBufferData(GL_ELEMENT_ARRAY_BUFFER, (GLsizeiptr)((size_t)b->nidx * (b->idx16 ? 2u : 4u)),
+                     b->idx, GL_STREAM_DRAW);
+        { static uint64_t tp; uint64_t t2 = tnow(); (void)tp; G.ns_upload_v += t2 - t0; }
+        glEnable(GL_CLIP_DISTANCE0);
+        glEnable(GL_CLIP_DISTANCE1);
+        vsh_line_width(b->gl_mode, 1);
+        glDrawElements((GLenum)b->gl_mode, (GLsizei)b->nidx,
+                       b->idx16 ? GL_UNSIGNED_SHORT : GL_UNSIGNED_INT, NULL);
+        vsh_line_width(b->gl_mode, 0);
+        glDisable(GL_CLIP_DISTANCE0);
+        glDisable(GL_CLIP_DISTANCE1);
+        glBindVertexArray(s_vao);
+        if (st->color_mask & 0x01010101u)
+            s->dirty = 1;
+        G.ns_draw += tnow() - t0;
+        return;
+    }
+    glUniform1ui(U.packed, 0u);
+    glBufferData(GL_ARRAY_BUFFER, (GLsizeiptr)((size_t)b->nverts * b->k * 16u),
+                 b->attrs, GL_STREAM_DRAW);
+    for (i = 0; i < 16; i++) {
+        if (b->slot[i] >= 0) {
+            glEnableVertexAttribArray((GLuint)i);
+            glVertexAttribPointer((GLuint)i, 4, GL_FLOAT, GL_FALSE, (GLsizei)(b->k * 16u),
+                                  (const void *)(uintptr_t)((uint32_t)b->slot[i] * 16u));
+        } else {
+            glDisableVertexAttribArray((GLuint)i);
+            glVertexAttrib4fv((GLuint)i, b->konst[i]);
+        }
+    }
+    glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, s_ibo_vsh);
+    glBufferData(GL_ELEMENT_ARRAY_BUFFER, (GLsizeiptr)((size_t)b->nidx * 4u), b->idx,
+                 GL_STREAM_DRAW);
+    glEnable(GL_CLIP_DISTANCE0);
+    glEnable(GL_CLIP_DISTANCE1);
+    {   /* gl_mode 0 (GL_POINTS) is never used here: 0 means a triangle list. */
+        GLenum mode = b->gl_mode ? (GLenum)b->gl_mode : GL_TRIANGLES;
+        vsh_line_width(mode, 1);
+        glDrawElements(mode, (GLsizei)b->nidx, GL_UNSIGNED_INT, NULL);
+        vsh_line_width(mode, 0);
+    }
+    glDisable(GL_CLIP_DISTANCE0);
+    glDisable(GL_CLIP_DISTANCE1);
+    glBindVertexArray(s_vao);
+    if (st->color_mask & 0x01010101u)
+        s->dirty = 1;
+    G.ns_draw += tnow() - t0;
+}
+
+void nv2a_gl_clear(const NvGlState *st, uint32_t flags, uint32_t argb, float z01,
+                   uint32_t x0, uint32_t y0, uint32_t x1, uint32_t y1)
+{
+    Surf *s;
+    GLbitfield bits = 0;
+
+    if (!nv2a_gl_enabled() || (st->bpp != 2 && st->bpp != 4))
+        return;
+    s = surf_bind(st);
+    if (flags & 0xF0) {
+        float c[4];
+        unpack_argb(argb, c);
+        if (st->bpp == 2)
+            c[3] = 1.0f;
+        if (x1 > s->w) x1 = s->w;
+        if (y1 > s->h) y1 = s->h;
+        /* Only the channels named (R 0x10, G 0x20, B 0x40, A 0x80); a 5:6:5
+         * surface keeps its alpha at 1. */
+        GLboolean cr = (flags & 0x10) != 0, cg = (flags & 0x20) != 0;
+        GLboolean cb = (flags & 0x40) != 0;
+        GLboolean ca = st->bpp == 4 ? (flags & 0x80) != 0 : GL_FALSE;
+        if (x0 < x1 && y0 < y1 && (cr || cg || cb || ca)) {
+            glScissor(SCX(s, x0), SC(y0), SCXW(s, x0, x1 - x0), SCW(y0, y1 - y0));
+            glColorMask(cr, cg, cb, ca);
+            glClearColor(c[0], c[1], c[2], c[3]);
+            glClear(GL_COLOR_BUFFER_BIT);
+            s->dirty = 1;
+        }
+    }
+    if ((flags & 0x03) && st->zeta_key) {
+        zbuf_attach(st->zeta_key, 1);
+        glDisable(GL_SCISSOR_TEST);
+        if (flags & 0x01) {
+            glDepthMask(GL_TRUE);
+            glClearDepth(z01 < 0.0f ? 0.0 : (z01 > 1.0f ? 1.0 : (double)z01));
+            bits |= GL_DEPTH_BUFFER_BIT;
+        }
+        if (flags & 0x02) {
+            glStencilMask(0xFF);
+            glClearStencil((GLint)(st->stencil_clear & 0xFF));
+            bits |= GL_STENCIL_BUFFER_BIT;
+        }
+        glClear(bits);
+        glEnable(GL_SCISSOR_TEST);
+    }
+}
+
+/* A new internal resolution: every target into guest memory at the old one
+ * and dropped (rebuilt from memory at the new size when next drawn), and
+ * everything sized from them with it. Depth starts over: this runs at the
+ * flip, between frames. */
+static void scale_change(int r)
+{
+    int i;
+    for (i = 0; i < MAX_SURF; i++)
+        if (s_surf[i].tex)
+            surf_free(i);
+    for (i = 0; i < MAX_ZBUF; i++) {
+        if (s_z[i].tex)
+            glDeleteTextures(1, &s_z[i].tex);
+        memset(&s_z[i], 0, sizeof s_z[i]);
+    }
+    s_z_attached_key = 0xFFFFFFFFu;
+    for (i = 0; i < MAX_TEX; i++)
+        if (s_tex[i].tex && s_tex[i].scaled) {
+            glDeleteTextures(1, &s_tex[i].tex);
+            memset(&s_tex[i], 0, sizeof s_tex[i]);
+        }
+    for (i = 0; i < 4; i++) {
+        if (self_tex[i])
+            glDeleteTextures(1, &self_tex[i]);
+        self_tex[i] = 0; self_w[i] = self_h[i] = 0;
+    }
+    s_scale = r;
+    s_scale_x = (int)(((int64_t)r * s_stretch + 50) / 100);
+    fprintf(stderr, "[GL] internal resolution x%.2f (screen width x%.2f)\n", s_scale / 100.0, s_scale_x / 100.0);
+}
+
+/* Render scale in hundredths (100..600); the whole-number calls below are
+ * the F1 menu's 1x-4x steps. */
+void nv2a_gl_request_scale_x100(int n)
+{
+    if (n < 100) n = 100;
+    if (n > 600) n = 600;
+    __atomic_store_n(&s_scale_req, n, __ATOMIC_RELEASE);
+}
+
+int nv2a_gl_get_scale_x100(void)
+{
+    int r = __atomic_load_n(&s_scale_req, __ATOMIC_ACQUIRE);
+    return r ? r : s_scale;
+}
+
+void nv2a_gl_request_scale(int n) { nv2a_gl_request_scale_x100(n * 100); }
+
+/* Widescreen stretch (screen aspect / 4:3) in hundredths: screen-sized
+ * targets get that much more width. Applied at the next flip. */
+void nv2a_gl_request_stretch_x100(int n)
+{
+    if (n < 100) n = 100;
+    if (n > 300) n = 300;
+    __atomic_store_n(&s_xs_req, n, __ATOMIC_RELEASE);
+}
+int  nv2a_gl_get_scale(void) { return (nv2a_gl_get_scale_x100() + 50) / 100; }
+
+/* ── Visibility reports ──────────────────────────────────────────────── */
+
+/* A test counts the pixels that pass between CLEAR_REPORT_VALUE and
+ * GET_REPORT while counting is enabled; each enabled stretch is one GL
+ * query ("segment"). Nothing here waits for the GPU except the synchronous
+ * mode: segments are ended and kept, and their results summed when the GPU
+ * has them.
+ *
+ * GET_REPORT modes (RECOMP_GL_ASYNC_REPORTS):
+ *   2 (default) predicted: answered at once with what the same test gave
+ *     last frame; the real count becomes a later frame's answer. Waiting
+ *     for it blocked on the whole queued frame, about 6 ms every frame.
+ *     "The same test": Lamborghini tests one point per light, a varying
+ *     number a frame, so matching by order (the k-th test) handed one
+ *     car's answer to another whenever a car came into or left view --
+ *     flares flickering and unevenly bright. Tests are matched by where
+ *     their point landed on screen (nearest within PH_NEAR pixels, among
+ *     the last few frames); a test that drew no point is exactly 0.
+ *   1 asynchronous: the record is written when the GPU answers (the HUD
+ *     disappears in Lamborghini: it reads the test in the same frame).
+ *   0 synchronous. */
+#define SEG_MAX 4
+#define REP_MAX 128
+#define PRED_MAX 64
+static GLuint s_query;                  /* the open segment's query */
+static int s_query_active, s_zpass_on;
+static GLuint s_seg[SEG_MAX];           /* ended segments of the current test */
+static int s_nseg;
+static uint64_t s_zpass_total;          /* segments already summed */
+static struct {
+    GLuint q[SEG_MAX]; int nq;
+    uint32_t at; uint64_t stamp, since_ns; uint64_t base; int pred_k;
+    float x, y; uint32_t frame; int pos;
+} s_rep[REP_MAX];
+static unsigned s_rep_head, s_rep_tail;
+static GLuint s_qpool[REP_MAX * SEG_MAX + 8];
+static int s_qpool_n;
+static uint32_t s_pred[PRED_MAX];
+static uint8_t  s_pred_set[PRED_MAX];
+/* Answered tests by screen position (mode 2). */
+#define PH_MAX 256
+#define PH_NEAR 24.0f
+#define PH_FRAMES 4u
+static struct { float x, y; uint32_t frame, count; } s_ph[PH_MAX];
+static unsigned s_ph_n;
+static float s_pt_x, s_pt_y;            /* the current test's point */
+static int s_pt_n;                      /* points drawn since CLEAR */
+
+void nv2a_gl_report_point(float x, float y)
+{
+    if (s_zpass_on) {
+        s_pt_x = x; s_pt_y = y;
+        s_pt_n++;
+    }
+}
+
+static int ph_on(void)
+{
+    static int on = -1;
+    if (on < 0) {
+        const char *e = getenv("RECOMP_GL_REPORT_MATCH");
+        on = !(e && *e == '0');
+    }
+    return on;
+}
+
+/* Last answer for a point near (x, y): the most recent frame's, nearest. */
+static uint32_t ph_predict(float x, float y)
+{
+    unsigned i, n = s_ph_n < PH_MAX ? s_ph_n : PH_MAX;
+    uint32_t best_f = 0, best_c = 1;    /* never seen: say "visible" */
+    float best_d = PH_NEAR * PH_NEAR;
+    int found = 0;
+    for (i = 0; i < n; i++) {
+        float dx = s_ph[i].x - x, dy = s_ph[i].y - y, d = dx * dx + dy * dy;
+        if (s_frame - s_ph[i].frame > PH_FRAMES || d > PH_NEAR * PH_NEAR)
+            continue;
+        if (!found || s_ph[i].frame > best_f || (s_ph[i].frame == best_f && d < best_d)) {
+            found = 1;
+            best_f = s_ph[i].frame; best_d = d; best_c = s_ph[i].count;
+        }
+    }
+    return best_c;
+}
+
+static int async_reports(void)
+{
+    static int on = -1;
+    if (on < 0) {
+        const char *e = getenv("RECOMP_GL_ASYNC_REPORTS");
+        on = !e ? 2 : (*e >= '0' && *e <= '2') ? *e - '0' : 2;
+    }
+    return on;
+}
+
+static GLuint q_new(void)
+{
+    GLuint q = 0;
+    if (s_qpool_n)
+        return s_qpool[--s_qpool_n];
+    glGenQueries(1, &q);
+    return q;
+}
+
+static void q_free(GLuint q)
+{
+    if (s_qpool_n < (int)(sizeof s_qpool / sizeof s_qpool[0]))
+        s_qpool[s_qpool_n++] = q;
+    else
+        glDeleteQueries(1, &q);
+}
+
+static uint64_t q_result(GLuint q)
+{
+    GLuint64 r = 0;
+    uint64_t t0 = xbox_HostNowNs();
+    glGetQueryObjectui64v(q, GL_QUERY_RESULT, &r);
+    G.ns_query += xbox_HostNowNs() - t0;
+    G.queries++;
+    {   /* pixels at 1x, rounded up: a D3D visibility test is one point,
+         * which covers one pixel at any scale -- rounded down it counted 0
+         * above 1x and Lamborghini hid every headlight/brake-light flare. */
+        int sx = s_cur >= 0 ? s_surf[s_cur].sx : s_scale;
+        uint64_t d = (uint64_t)((int64_t)s_scale * (sx ? sx : 100));
+        return (r * 10000u + d - 1) / d;
+    }
+}
+
+static void query_end(void)
+{
+    if (!s_query_active)
+        return;
+    glEndQuery(GL_SAMPLES_PASSED);
+    s_query_active = 0;
+    if (s_nseg < SEG_MAX) {
+        s_seg[s_nseg++] = s_query;
+    } else {                            /* too many: fold one in now */
+        s_zpass_total += q_result(s_query);
+        q_free(s_query);
+    }
+    s_query = 0;
+}
+
+static void query_begin(void)
+{
+    if (s_query_active)
+        return;
+    if (!s_query)
+        s_query = q_new();
+    glBeginQuery(GL_SAMPLES_PASSED, s_query);
+    s_query_active = 1;
+}
+
+static void segs_drop(void)
+{
+    int i;
+    for (i = 0; i < s_nseg; i++)
+        q_free(s_seg[i]);
+    s_nseg = 0;
+    s_zpass_total = 0;
+}
+
+void nv2a_gl_report_clear(void)
+{
+    if (!nv2a_gl_enabled())
+        return;
+    query_end();
+    segs_drop();
+    s_pt_n = 0;
+    s_cnt_draws = 0;
+    if (s_zpass_on)
+        query_begin();
+}
+
+void nv2a_gl_report_enable(int on)
+{
+    if (!nv2a_gl_enabled())
+        return;
+    s_zpass_on = on != 0;
+    if (s_zpass_on)
+        query_begin();
+    else
+        query_end();
+}
+
+static void rep_write(uint32_t at, uint64_t stamp, uint64_t count)
+{
+    uint8_t *m = guest(at);
+    uint32_t c = count > 0xFFFFFFFFu ? 0xFFFFFFFFu : (uint32_t)count;
+    memcpy(m, &stamp, 8);
+    memcpy(m + 8, &c, 4);
+    memset(m + 12, 0, 4);
+}
+
+
+/* Synchronous read of the current test (and the counter goes on). */
+uint32_t nv2a_gl_report_read(void)
+{
+    uint64_t sum;
+    int i;
+    if (!nv2a_gl_enabled())
+        return 0;
+    query_end();
+    for (i = 0; i < s_nseg; i++) {
+        s_zpass_total += q_result(s_seg[i]);
+        q_free(s_seg[i]);
+    }
+    s_nseg = 0;
+    sum = s_zpass_total;
+    if (s_zpass_on)
+        query_begin();
+    return sum > 0xFFFFFFFFu ? 0xFFFFFFFFu : (uint32_t)sum;
+}
+
+/* Write every finished report, oldest first. block_ns: also wait for an
+ * asynchronous (mode 1) report older than that. */
+void nv2a_gl_report_poll(uint64_t block_ns)
+{
+    uint64_t now = 0;
+    if (s_state != 1 || !pthread_equal(s_thread, pthread_self()))
+        return;
+    while (s_rep_tail != s_rep_head) {
+        unsigned k = s_rep_tail % REP_MAX;
+        int j, ready = 1;
+        uint64_t sum = s_rep[k].base;
+        for (j = 0; j < s_rep[k].nq && ready; j++) {
+            GLuint avail = 0;
+            glGetQueryObjectuiv(s_rep[k].q[j], GL_QUERY_RESULT_AVAILABLE, &avail);
+            ready = avail != 0;
+        }
+        if (!ready) {
+            if (!block_ns || s_rep[k].pred_k >= 0)
+                break;
+            if (!now)
+                now = xbox_HostNowNs();
+            if (now - s_rep[k].since_ns < block_ns)
+                break;
+        }
+        for (j = 0; j < s_rep[k].nq; j++) {
+            sum += q_result(s_rep[k].q[j]);
+            q_free(s_rep[k].q[j]);
+        }
+        if (s_rep[k].pred_k >= 0) {
+            s_pred[s_rep[k].pred_k] = sum > 0xFFFFFFFFu ? 0xFFFFFFFFu : (uint32_t)sum;
+            s_pred_set[s_rep[k].pred_k] = 1;
+            if (s_rep[k].pos) {
+                unsigned h = s_ph_n++ % PH_MAX;
+                s_ph[h].x = s_rep[k].x; s_ph[h].y = s_rep[k].y;
+                s_ph[h].frame = s_rep[k].frame;
+                s_ph[h].count = s_pred[s_rep[k].pred_k];
+            }
+        } else {
+            rep_write(s_rep[k].at, s_rep[k].stamp, sum);
+        }
+        s_rep_tail++;
+    }
+}
+
+/* GET_REPORT: returns 1 when this module writes the record (now, or when
+ * the GPU answers); 0 when the caller writes *count now. */
+int nv2a_gl_report_submit(uint32_t at, uint64_t stamp, uint32_t *count)
+{
+    int mode;
+    if (!nv2a_gl_enabled())
+        return 0;
+    mode = async_reports();
+    if (!mode || s_rep_head - s_rep_tail >= REP_MAX) {
+        *count = nv2a_gl_report_read();
+        return 0;
+    }
+    query_end();
+    {
+        unsigned k = s_rep_head % REP_MAX;
+        int i;
+        s_rep[k].nq = s_nseg;
+        for (i = 0; i < s_nseg; i++)
+            s_rep[k].q[i] = s_seg[i];
+        s_rep[k].base = s_zpass_total;
+        s_rep[k].at = at;
+        s_rep[k].stamp = stamp;
+        s_rep[k].since_ns = xbox_HostNowNs();
+        s_rep[k].pred_k = -1;
+        if (mode == 2 && s_pred_k < PRED_MAX) {
+            int pk = s_pred_k++;
+            uint32_t c;
+            s_rep[k].pred_k = pk;
+            s_rep[k].pos = 0;
+            if (ph_on() && s_pt_n == 1 && s_cnt_draws == 1) {  /* one point: match by place */
+                s_rep[k].pos = 1;
+                s_rep[k].x = s_pt_x; s_rep[k].y = s_pt_y;
+                s_rep[k].frame = s_frame;
+                c = ph_predict(s_pt_x, s_pt_y);
+            } else if (ph_on() && s_pt_n == 0 && s_cnt_draws == 0) {
+                c = 0;                      /* nothing drawn: exactly 0 */
+            } else {
+                /* Never seen: say "visible" rather than hide something. */
+                c = s_pred_set[pk] ? s_pred[pk] : 1u;
+            }
+            rep_write(at, stamp, c);
+        }
+        s_rep_head++;
+    }
+    /* The counter goes on from zero, as after a synchronous read it would
+     * have gone on from the total; a second GET_REPORT without a CLEAR is
+     * then short by this one's count (not seen in practice). */
+    s_nseg = 0;
+    s_zpass_total = 0;
+    if (s_zpass_on)
+        query_begin();
+    nv2a_gl_report_poll(0);
+    return 1;
+}
+
+void nv2a_gl_report_stats(void)
+{
+    if (s_state != 1)
+        return;
+    fprintf(stderr, "[GL] relabels %llu, cube maps copied from targets %llu, async presents %llu"
+            " (%.0f ms), sparse texture checks %llu\n",
+            (unsigned long long)G.relabels, (unsigned long long)G.cube_copies,
+            (unsigned long long)G.async_presents, G.ns_present / 1e6,
+            (unsigned long long)G.sparse_hits);
+    fprintf(stderr, "[GL] self-sampling copies %llu, GPU vertex-program draws %llu"
+            " | vsh draw: setup %.0f ms, to-upload-end %.0f ms, total %.0f ms\n",
+            (unsigned long long)G.self_copies, (unsigned long long)G.vsh_draws,
+            G.ns_setup / 1e6, G.ns_upload_v / 1e6, G.ns_draw / 1e6);
+    G.ns_setup = G.ns_upload_v = 0;
+    fprintf(stderr, "[GL] render targets sampled in place %llu; readbacks: present %llu"
+            " alias %llu texture %llu (last fmt %02X %ux%u cube %u) evict %llu sync_all %llu\n",
+            (unsigned long long)G.rt_samples, (unsigned long long)G.rb_why[0],
+            (unsigned long long)G.rb_why[1], (unsigned long long)G.rb_why[2],
+            G.last_tex_color, G.last_tex_w, G.last_tex_h, G.last_tex_cube,
+            (unsigned long long)G.rb_why[3], (unsigned long long)G.rb_why[4]);
+    fprintf(stderr, "[GL] since last: %llu draws (%llu verts) %.0f ms incl. below |"
+            " readbacks %llu %.0f ms | uploads %llu %.0f ms | rehash %llu + tex %.0f ms |"
+            " decodes %llu %.0f ms | query waits %llu %.0f ms\n",
+            (unsigned long long)G.draws, (unsigned long long)G.verts, G.ns_draw / 1e6,
+            (unsigned long long)G.readbacks, G.ns_readback / 1e6,
+            (unsigned long long)G.uploads, G.ns_upload / 1e6,
+            (unsigned long long)G.rehash, G.ns_hash / 1e6,
+            (unsigned long long)G.decodes, G.ns_decode / 1e6,
+            (unsigned long long)G.queries, G.ns_query / 1e6);
+    memset(&G, 0, sizeof G);
+}
+
+#endif /* !_WIN32 */
diff --git a/src/kernel/nv2a_gl.h b/src/kernel/nv2a_gl.h
new file mode 100644
index 0000000..1c06497
--- /dev/null
+++ b/src/kernel/nv2a_gl.h
@@ -0,0 +1,163 @@
+/*
+ * NV2A pixel work on the host GPU (OpenGL 4.3 core, EGL surfaceless).
+ *
+ * The pushbuffer executor (nv2a_pb_exec.c) keeps doing everything up to and
+ * including vertex processing on the CPU -- vertex programs, fixed-function
+ * transform, near-plane clipping -- and with RECOMP_GL=1 hands the resulting
+ * screen-space triangles here instead of to its software rasteriser. This
+ * module draws them with a fragment shader that evaluates the register
+ * combiners the way nv2a_combiner.c does, with all four texture stages, fog,
+ * alpha test, blending and depth.
+ *
+ * Guest memory stays the authority on what a surface holds: each colour
+ * surface the title draws into is mirrored in a GL texture (uploaded from
+ * guest memory on first use, or when the CPU has written it since), and the
+ * texture is written back to guest memory when the title moves to another
+ * surface, before a flip is presented, and before anything samples or dumps
+ * it. Only the surface currently being drawn can be ahead of guest memory.
+ * So the window, the snapshot code and render-to-texture all keep working
+ * from guest memory unchanged.
+ *
+ * Everything is called on the executor thread, which owns the GL context.
+ * POSIX only for now (EGL); elsewhere nv2a_gl_enabled() returns 0 and the
+ * software rasteriser runs as before.
+ */
+#ifndef NV2A_GL_H
+#define NV2A_GL_H
+
+#include <stdint.h>
+#include "nv2a_combiner.h"
+
+/* One vertex as the rasteriser would see it. */
+typedef struct {
+    float pos[4];       /* surface pixels x, y; z in the title's units; w */
+    float d0[4], d1[4]; /* diffuse, specular: r g b a */
+    float fog;          /* fog factor, 0..1 (1 = no fog) */
+    float tex[4][4];    /* texture coordinates per stage (s t r q) */
+} NvGlVertex;
+
+/* A texture stage as programmed. */
+typedef struct {
+    uint32_t valid;
+    uint32_t offset;            /* guest VA of texel (0,0) */
+    uint32_t width, height, pitch, color;
+    uint32_t addr_u, addr_v;    /* 1 wrap, 2 mirror, 3 clamp, 4 border */
+    uint32_t filter, border, border_color, cube;
+    uint32_t linear;            /* coordinates in texels, not 0..1 */
+    uint32_t palette;           /* guest VA of the 256-entry CLUT, or 0 */
+    uint32_t face_stride;       /* bytes between cube faces */
+    uint32_t bytes;             /* bytes the texture occupies (all faces) */
+    uint32_t levels;            /* mip levels the title declares (1 = none) */
+    float    bump_mat[4];       /* BUMP_ENV_MAT m00 m01 m10 m11 */
+    float    bump_scale, bump_offset;
+} NvGlTex;
+
+typedef struct {
+    /* Colour surface: guest VA, pitch, bytes per pixel; swizzled surfaces
+     * are swz_w x swz_h texels in Morton order. */
+    uint32_t color_va, pitch, bpp, swz, swz_w, swz_h;
+    uint32_t clip_x, clip_y, clip_w, clip_h;
+    uint32_t sc_x, sc_y, sc_w, sc_h;    /* draw scissor (window clip applied) */
+    /* Depth buffer: keyed by the zeta offset (0 = none); zmax is the largest
+     * depth value of its format (65535 for Z16, 16777215 for Z24S8). */
+    uint32_t zeta_key;
+    float    zmax;
+    /* Raster state, NV2A (GL) enum values. */
+    uint32_t depth_test, depth_func, depth_mask, color_mask;
+    uint32_t alpha_test, alpha_func, alpha_ref;
+    uint32_t blend_enable, blend_src, blend_dst, blend_eq, blend_color;
+    /* Stencil (GL enum values; the depth buffer carries 8 stencil bits). */
+    uint32_t stencil_test, stencil_func, stencil_ref, stencil_func_mask;
+    uint32_t stencil_write_mask, stencil_fail, stencil_zfail, stencil_zpass;
+    uint32_t stencil_clear;     /* CLEAR_SURFACE value for flag 0x2 */
+    uint32_t use_rc;            /* register combiners (else diffuse * tex0) */
+    uint32_t textured;          /* without combiners: stage 0 bound */
+    uint32_t clip_plane_mode;   /* SET_SHADER_CLIP_PLANE_MODE */
+    uint32_t cull_enable, cull_face, front_face;  /* SET_CULL_FACE_ENABLE, CULL_FACE, FRONT_FACE */
+    uint32_t other_stage_input; /* SET_SHADER_OTHER_STAGE_INPUT */
+    uint32_t dot_mapping;       /* SET_DOT_RGBMAPPING: stage i at bits 4*(i-1) */
+    float    eye[3];            /* SET_EYE_VECTOR (DOT_RFLCT_SPEC_CONST) */
+    Nv2aCombiner rc;
+    float    fog_color[4];      /* r g b a */
+    NvGlTex  tex[4];
+} NvGlState;
+
+/* Decode one face of a texture to 0xAARRGGBB, width*height texels. */
+typedef int (*NvGlDecodeFn)(const NvGlTex *t, uint32_t face, uint32_t *argb);
+
+/* 1 when RECOMP_GL is set and the GL context came up (tried once). */
+int  nv2a_gl_enabled(void);
+void nv2a_gl_set_decoder(NvGlDecodeFn fn);
+
+/* nverts vertices: a triangle list, or points (one pixel each). */
+void nv2a_gl_draw(const NvGlState *s, const NvGlVertex *v, uint32_t nverts,
+                  int points);
+
+/* CLEAR_SURFACE. flags: Z 0x1, stencil 0x2, colour 0xF0. The colour clear
+ * covers [x0,x1) x [y0,y1); depth clears the whole buffer. z01 is the clear
+ * depth divided by zmax. */
+void nv2a_gl_clear(const NvGlState *s, uint32_t flags, uint32_t argb, float z01,
+                   uint32_t x0, uint32_t y0, uint32_t x1, uint32_t y1);
+
+/* Visibility tests (pixels passing depth while counting is enabled). */
+void     nv2a_gl_report_clear(void);
+void     nv2a_gl_report_enable(int on);
+uint32_t nv2a_gl_report_read(void);
+int      nv2a_gl_report_submit(uint32_t at, uint64_t stamp, uint32_t *count);
+void     nv2a_gl_report_poll(uint64_t block_ns);
+/* The point a visibility test is about to draw, in surface pixels. */
+void     nv2a_gl_report_point(float x, float y);
+
+/* A vertex-program batch for the GPU: the program and constants as
+ * nv2a_vsh_export packs them, the distinct vertices' inputs (k vec4 each;
+ * slot[i] is input i's place, or -1 for the constant konst[i]), and a
+ * triangle list over them. */
+typedef struct {
+    const float *attrs;
+    uint32_t nverts, k;
+    int8_t   slot[16];
+    float    konst[16][4];
+    const uint32_t *idx;
+    uint32_t nidx;
+    const uint32_t (*prog)[8];
+    uint32_t nins, prog_gen;
+    const float *consts;        /* 192 x vec4 */
+    uint32_t const_gen;
+    float    aa_sx, aa_sy, near_z;
+    uint32_t fog_enable, fog_mode;
+    float    fog_p[2];
+    /* raw = 1: attrs holds the title's own vertex bytes (attr_bytes long),
+     * each array input i read at buffer offset off[i] + index * stride[i] in
+     * NV2A format type[i] / size[i]; idx is indices rebased to the span (16
+     * or 32 bits, idx16) drawn as GL primitive gl_mode. */
+    int      raw, idx16;
+    uint32_t attr_bytes, gl_mode;
+    uint32_t off[16], stride[16];
+    uint8_t  type[16], size[16];
+    /* Widescreen: flat = every vertex came out at w 1 (a screen-space,
+     * 2D draw -- HUD, menus); flat_minx/maxx its extent in surface x. */
+    int      flat;
+    float    flat_minx, flat_maxx;
+    uint32_t flat_n;            /* vertices (indices) in the draw */
+} NvGlVshBatch;
+
+int  nv2a_gl_vsh_available(void);
+/* Widescreen stretch in effect: the executor then classifies 2D draws. */
+int  nv2a_gl_hud_active(void);
+int  nv2a_flat_w(float w);
+void nv2a_gl_draw_vsh(const NvGlState *s, const NvGlVshBatch *b);
+
+/* Bring guest memory up to date with everything drawn so far. */
+void nv2a_gl_sync_all(void);
+/* The same, except the current render target. */
+void nv2a_gl_sync_small(void);
+
+/* A flip of the surface at guest VA `va` (pitch bytes a row). Returns 1 when
+ * the GL path handed the window the frame itself (asynchronously, a frame
+ * behind); 0 when guest memory is current and the caller presents from it. */
+int nv2a_gl_present(uint32_t va, uint32_t pitch);
+
+/* One line of counters to stderr (for the executor's periodic report). */
+void nv2a_gl_report_stats(void);
+
+#endif /* NV2A_GL_H */
