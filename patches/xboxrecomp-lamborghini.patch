+static void decode_src(const uint32_t *ins, int which, VshSrc *d)
+{
+    uint32_t swz;
+    if (which == 0) {
+        d->neg = (uint8_t)field(ins, 1, 8, 1); swz = field(ins, 1, 0, 8);
+        d->mux = (uint8_t)field(ins, 2, 26, 2); d->reg = (uint8_t)field(ins, 2, 28, 4);
+    } else if (which == 1) {
