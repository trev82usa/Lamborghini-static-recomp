+/* nv2a_rc_eval and rc_stage_fetch, register for register. Register numbers:
+ * 0 zero, 1 c0, 2 c1, 3 fog, 4 v0, 5 v1, 8-11 t0-t3, 12 r0, 13 r1,
+ * 14 v1+r0 sum, 15 E*F (final combiner only). */
+static const char *FS =
+"#version 430 core\n"
+"noperspective in vec4 v_d0;\n"
+"noperspective in vec4 v_d1;\n"
+"noperspective in float v_fog;\n"
+"in vec4 v_t0; in vec4 v_t1; in vec4 v_t2; in vec4 v_t3;\n"
+"layout(location=0) out vec4 o_color;\n"
+"uniform sampler2D u_tex2d[4];\n"
+"uniform samplerCube u_texcube[4];\n"
+"uniform vec2 u_texscale[4];\n"
+"uniform int u_texvalid[4];\n"
+"uniform int u_texcubeflag[4];\n"
+"uniform int u_mode;\n"            /* 0 combiners, 1 diffuse*tex0, 2 point */
+"uniform int u_textured;\n"
+"uniform uint u_cicw[8]; uniform uint u_aicw[8];\n"
+"uniform uint u_cocw[8]; uniform uint u_aocw[8];\n"
+"uniform vec4 u_f0[8]; uniform vec4 u_f1[8];\n"
+"uniform uint u_final0; uniform uint u_final1;\n"
+"uniform vec4 u_fc0; uniform vec4 u_fc1;\n"
+"uniform uint u_control; uniform uint u_stageprog; uniform uint u_clipmode;\n"
+"uniform vec4 u_bumpmat[4]; uniform vec2 u_bumplum[4]; uniform uint u_otherin;\n"
+"uniform uint u_dotmap; uniform vec3 u_eye;\n"
+"uniform int u_dbgview;\n"
+"uniform vec4 u_fogcolor;\n"
+"uniform int u_atest; uniform uint u_afunc; uniform int u_aref;\n"
+"vec4 R[16];\n"
+"float map_in(float x, uint b) {\n"
+"    float p = max(x, 0.0);\n"
+"    switch ((b >> 5) & 7u) {\n"
+"    case 0u: return p;\n"
+"    case 1u: return 1.0 - clamp(x, 0.0, 1.0);\n"
+"    case 2u: return 2.0 * p - 1.0;\n"
+"    case 3u: return -2.0 * p + 1.0;\n"
+"    case 4u: return p - 0.5;\n"
+"    case 5u: return -p + 0.5;\n"
+"    case 6u: return x;\n"
+"    default: return -x;\n"
+"    }\n"
+"}\n"
+"float map_out(float x, uint m) {\n"
+"    if (m == 0x08u) return x - 0.5;\n"
+"    if (m == 0x10u) return x * 2.0;\n"
+"    if (m == 0x18u) return (x - 0.5) * 2.0;\n"
+"    if (m == 0x20u) return x * 4.0;\n"
+"    if (m == 0x30u) return x * 0.5;\n"
+"    return x;\n"
+"}\n"
+"vec3 map_out3(vec3 v, uint m) {\n"
+"    return clamp(vec3(map_out(v.x, m), map_out(v.y, m), map_out(v.z, m)), -1.0, 1.0);\n"
+"}\n"
+"vec3 read_rgb(uint b) {\n"
+"    vec4 r = R[b & 15u];\n"
+"    vec3 v = ((b & 16u) != 0u) ? vec3(r.a) : r.rgb;\n"
+"    return vec3(map_in(v.x, b), map_in(v.y, b), map_in(v.z, b));\n"
+"}\n"
+"float read_alpha(uint b) {\n"
+"    vec4 r = R[b & 15u];\n"
+"    return map_in(((b & 16u) != 0u) ? r.a : r.b, b);\n"
+"}\n"
+"vec4 fetch2d(int st, vec2 uv) {\n"
+"    if (u_texvalid[st] == 0) return vec4(1.0);\n"
+"    return texture(u_tex2d[st], uv * u_texscale[st]);\n"
+"}\n"
+"float sgn8(float x) {\n"
+"    float b = floor(x * 255.0 + 0.5);\n"
+"    if (b >= 128.0) b -= 256.0;\n"
+"    return clamp(b / 127.0, -1.0, 1.0);\n"
+"}\n"
+/* Texture-shader dot-product family (xemu psh.c): a stage dots its own
+ * texture coordinates with the input stage's texel, mapped to a vector by
+ * SET_DOT_RGBMAPPING; two or three such dots form the coordinates (or the
+ * normal for a reflection) the last stage samples with. Water, wet roads,
+ * per-pixel lighting and bumped environment reflections. */
+"float g_dot[4];\n"
+"vec4 tcoord(int i) { return i == 0 ? v_t0 : i == 1 ? v_t1 : i == 2 ? v_t2 : v_t3; }\n"
+"int in_stage(int st) {\n"
+"    int src = st == 2 ? int((u_otherin >> 16) & 15u) : st == 3 ? int((u_otherin >> 20) & 15u) : 0;\n"
+"    return src < st ? src : st - 1;\n"
+"}\n"
+"float sbyte(float x, uint m) {\n"
+"    float b = floor(clamp(x, 0.0, 1.0) * 255.0 + 0.5);\n"
+"    if (m == 1u) return (b - 128.0) / 127.0;\n"          /* -1..1 D3D */
+"    if (m == 2u) return (b - 127.5) / 127.5;\n"          /* -1..1 GL */
+"    if (m == 3u) return (b >= 128.0 ? b - 256.0 : b) / 127.0;\n"  /* two's complement */
+"    return x;\n"
+"}\n"
+"vec3 dotmap(vec4 col, uint m) {\n"
+"    if (m >= 1u && m <= 3u) return vec3(sbyte(col.r, m), sbyte(col.g, m), sbyte(col.b, m));\n"
+"    if (m >= 4u) {\n"  /* HILO: not decoded as such here; 2x-1 in r,g, z from the hemisphere */
+"        vec2 h = col.rg * 2.0 - 1.0;\n"
+"        return vec3(h, m == 4u ? 1.0 : sqrt(max(0.0, 1.0 - dot(h, h))));\n"
+"    }\n"
+"    return col.rgb;\n"
+"}\n"
+"float dot_stage(int st, vec4 prev[4]) {\n"
+"    uint m = (u_dotmap >> uint(4 * (st - 1))) & 7u;\n"
+"    g_dot[st] = dot(tcoord(st).xyz, dotmap(prev[in_stage(st)], m));\n"
+"    return g_dot[st];\n"
+"}\n"
+"vec4 fetchcube(int st, vec3 d) {\n"
+"    if (u_texvalid[st] == 0) return vec4(1.0);\n"
+"    if (u_texcubeflag[st] == 0) return fetch2d(st, d.xy);\n"
+"    return texture(u_texcube[st], d);\n"
+"}\n"
+"vec3 reflect_eye(vec3 n, vec3 e) {\n"
+"    float nn = dot(n, n);\n"
+"    return nn > 0.0 ? 2.0 * n * dot(n, e) / nn - e : -e;\n"
+"}\n"
+"vec4 stage(int st, vec4 c, vec4 prev[4]) {\n"
+"    uint mode = (u_stageprog >> uint(st * 5)) & 31u;\n"
+"    float q = c.w != 0.0 ? c.w : 1.0;\n"
+"    if (mode >= 8u && st == 0) return vec4(0.0, 0.0, 0.0, 1.0);\n"
+"    if (mode == 9u) {\n"   /* DOT_ST: (dot of stage-1, dot here) */
+"        float d = dot_stage(st, prev);\n"
+"        return fetch2d(st, vec2(g_dot[st - 1], d));\n"
+"    }\n"
+"    if (mode == 10u || mode == 17u) {\n"   /* DOT_ZW (depth replace not modelled), DOT_PRODUCT */
+"        dot_stage(st, prev);\n"
+"        return vec4(0.0);\n"
+"    }\n"
+"    if (mode == 11u) {\n"  /* DOT_RFLCT_DIFF (stage 2): normal from stages 1, 2, 3 */
+"        float d = dot_stage(st, prev);\n"
+"        uint m3 = (u_dotmap >> 8u) & 7u;\n"
+"        float d3 = dot(v_t3.xyz, dotmap(prev[in_stage(3)], m3));\n"
+"        return fetchcube(st, vec3(g_dot[1], d, d3));\n"
+"    }\n"
+"    if (mode == 12u || mode == 18u) {\n"  /* DOT_RFLCT_SPEC (_CONST): eye from q, or SET_EYE_VECTOR */
+"        float d = dot_stage(st, prev);\n"
+"        vec3 n = vec3(g_dot[1], g_dot[2], d);\n"
+"        vec3 e = mode == 12u ? vec3(v_t1.w, v_t2.w, v_t3.w) : u_eye;\n"
+"        return fetchcube(st, reflect_eye(n, e));\n"
+"    }\n"
+"    if (mode == 13u) {\n"  /* DOT_STR_3D: no 3D textures; s,t of the 3D lookup */
+"        float d = dot_stage(st, prev);\n"
+"        return fetch2d(st, vec2(g_dot[1], g_dot[2]) / (d != 0.0 ? d : 1.0));\n"
+"    }\n"
+"    if (mode == 14u) {\n"  /* DOT_STR_CUBE */
+"        float d = dot_stage(st, prev);\n"
+"        return fetchcube(st, vec3(g_dot[1], g_dot[2], d));\n"
+"    }\n"
+"    if (mode == 15u) return fetch2d(st, prev[in_stage(st)].ar);\n"  /* DEPENDENT_AR */
+"    if (mode == 16u) return fetch2d(st, prev[in_stage(st)].gb);\n"  /* DEPENDENT_GB */
+"    if (mode == 8u) return vec4(0.0);\n"  /* BRDF: not modelled */
+"    if (mode == 6u || mode == 7u) {\n"   /* BUMPENVMAP (_LUM) */
+"        if (st == 0) return vec4(0.0, 0.0, 0.0, 1.0);\n"
+"        int src = st == 2 ? int((u_otherin >> 16) & 15u) : st == 3 ? int((u_otherin >> 20) & 15u) : 0;\n"
+"        if (src >= st) src = st - 1;\n"
+"        vec4 s = prev[src];\n"
+"        vec2 d = vec2(sgn8(s.b), sgn8(s.g));\n"
+"        vec4 m = u_bumpmat[st];\n"
+"        vec4 r = fetch2d(st, c.xy / q + vec2(m.x * d.x + m.z * d.y, m.y * d.x + m.w * d.y));\n"
+"        if (mode == 7u) r.rgb *= clamp(s.r * u_bumplum[st].x + u_bumplum[st].y, 0.0, 1.0);\n"
+"        return r;\n"
+"    }\n"
+"    if (mode == 0u) return vec4(0.0, 0.0, 0.0, 1.0);\n"
+"    if (mode == 1u || mode == 2u) return fetch2d(st, c.xy / q);\n"
+"    if (mode == 3u) {\n"
+"        if (u_texvalid[st] == 0) return vec4(1.0);\n"
+"        if (u_texcubeflag[st] == 0) return fetch2d(st, c.xy);\n"
+"        return texture(u_texcube[st], c.xyz);\n"
+"    }\n"
+"    if (mode == 4u) return clamp(c, 0.0, 1.0);\n"
+"    if (mode == 5u) {\n"
+"        for (int j = 0; j < 4; j++) {\n"
+"            bool ge = ((u_clipmode >> uint(st * 4 + j)) & 1u) != 0u;\n"
+"            if (ge ? c[j] >= 0.0 : c[j] < 0.0) discard;\n"
+"        }\n"
+"        return vec4(0.0);\n"
+"    }\n"
+"    return vec4(0.0);\n"
+"}\n"
+"bool alpha_pass(float a) {\n"
+"    int v = int(a * 255.0 + 0.5);\n"
+"    switch (u_afunc) {\n"
+"    case 0x200u: return false;\n"
+"    case 0x201u: return v < u_aref;\n"
+"    case 0x202u: return v == u_aref;\n"
+"    case 0x203u: return v <= u_aref;\n"
+"    case 0x204u: return v > u_aref;\n"
+"    case 0x205u: return v != u_aref;\n"
+"    case 0x206u: return v >= u_aref;\n"
+"    default: return true;\n"
+"    }\n"
+"}\n"
+"void main() {\n"
+"    vec4 outc;\n"
+"    if (u_mode == 2) {\n"
+"        outc = clamp(v_d0, 0.0, 1.0);\n"
+"    } else if (u_mode == 1) {\n"
+"        outc = clamp(v_d0, 0.0, 1.0);\n"
+"        if (u_textured != 0) {\n"
+"            vec4 t = fetch2d(0, v_t0.xy / (v_t0.w != 0.0 ? v_t0.w : 1.0));\n"
+"            outc = clamp(t * v_d0, 0.0, 1.0);\n"
+"        }\n"
+"    } else {\n"
+"        vec4 t[4] = vec4[4](vec4(0.0), vec4(0.0), vec4(0.0), vec4(0.0));\n"
+"        g_dot = float[4](0.0, 0.0, 0.0, 0.0);\n"
+"        t[0] = stage(0, v_t0, t); t[1] = stage(1, v_t1, t);\n"
+"        t[2] = stage(2, v_t2, t); t[3] = stage(3, v_t3, t);\n"
+"        for (int i = 0; i < 16; i++) R[i] = vec4(0.0);\n"
