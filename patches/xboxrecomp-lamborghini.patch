+            if (n) { s->px = n; s->cap = need; }
+        }
+        if (s->cap >= need) {
+            for (y = 0; y < h; y++)
+                memcpy(s->px + (size_t)y * w * 4, (const uint8_t *)px + (size_t)y * pitch,
+                       (size_t)w * 4);
+            s->w = w; s->h = h;
+            publish(4);
+        }
+    }
+    __atomic_sub_fetch(&s_in_present, 1, __ATOMIC_SEQ_CST);
