+/* Effect sends without the GP DSP.
+ *
+ * Mixbins 0-5 are the speakers (FL FR C LFE BL BR), 6-9 the crosstalk
+ * pairs (FL FR BL BR), 10 the I3DL2 reverb send and 11-31 FX sends that the
+ * title's GP program turns into speaker output. The GP is not emulated, so
+ * those sends used to be summed raw into the even/odd channel -- which put
+ * a send in ONE speaker only. Lamborghini routes every engine voice only to
+ * FX send 20 (bin 31): its engines played in the right speaker alone, and
+ * its high-rpm layer, a near-square wave that its DSP image
+ * (audio\dspimage.bin) shapes on hardware, came out as a raw buzz with the
+ * rev limiter crackling.
+ *
+ * Here the sends are summed, smoothed by a 2-pole low-pass and sent to
+ * both speakers, and centre/LFE go to both too. RECOMP_APU_FX_LOWPASS=<Hz>
+ * sets the cutoff (default 3000); 0 restores the even/odd mixdown.
+ * ponytail: an approximation of what the title's DSP effect does, not the
+ * effect itself -- the real fix is running the GP program (DSP56300). */
+static float s_fx_b0, s_fx_b1, s_fx_b2, s_fx_a1, s_fx_a2;
+static float s_fx_x1, s_fx_x2, s_fx_y1, s_fx_y2;
+static float s_fx2_x1, s_fx2_x2, s_fx2_y1, s_fx2_y2;
+
+static int fx_lowpass_on(void)
+{
+    static int on = -1;
+    if (on < 0) {
+        const char *e = getenv("RECOMP_APU_FX_LOWPASS");
+        float fc = (e && *e) ? (float)atof(e) : 900.0f;
+        on = fc > 0.0f;
+        if (on) {
+            /* RBJ cookbook low-pass, Q = 1/sqrt(2), at 48 kHz. */
+            const float pi = 3.14159265f;
+            float w = 2.0f * pi * (fc < 20000.0f ? fc : 20000.0f) / 48000.0f;
+            float c = cosf(w), al = sinf(w) / (2.0f * 0.70710678f), a0 = 1.0f + al;
+            s_fx_b0 = (1.0f - c) / 2.0f / a0;
+            s_fx_b1 = (1.0f - c) / a0;
+            s_fx_b2 = s_fx_b0;
+            s_fx_a1 = -2.0f * c / a0;
+            s_fx_a2 = (1.0f - al) / a0;
+            fprintf(stderr, "[APU] effect sends: %.0f Hz low-pass, to both speakers"
+                            " (RECOMP_APU_FX_LOWPASS)\n", fc);
+        }
+    }
+    return on;
+}
+
+static float fx_lowpass(float x)
+{
+    /* 4-pole (24 dB/oct) cascaded biquad to shape raw high-RPM synth waves */
+    float y1 = s_fx_b0 * x + s_fx_b1 * s_fx_x1 + s_fx_b2 * s_fx_x2
+             - s_fx_a1 * s_fx_y1 - s_fx_a2 * s_fx_y2;
+    s_fx_x2 = s_fx_x1; s_fx_x1 = x;
+    s_fx_y2 = s_fx_y1; s_fx_y1 = y1;
+
+    float y2 = s_fx_b0 * y1 + s_fx_b1 * s_fx2_x1 + s_fx_b2 * s_fx2_x2
+             - s_fx_a1 * s_fx2_y1 - s_fx_a2 * s_fx2_y2;
+    s_fx2_x2 = s_fx2_x1; s_fx2_x1 = y1;
+    s_fx2_y2 = s_fx2_y1; s_fx2_y1 = y2;
+    return y2 * 0.65f;
+}
