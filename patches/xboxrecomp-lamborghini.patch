+"    v_fog = fogf(O[5].x);\n"
+"    v_t0 = O[9]; v_t1 = O[10]; v_t2 = O[11]; v_t3 = O[12];\n"
+"    pos.x = pos.x * u_hud.x + u_hud.y;\n"
+"    vec2 ndc = pos.xy / u_size * 2.0 - 1.0;\n"
+"    float zn = u_z01 != 0 ? pos.z * u_zscale : pos.z * u_zscale * 2.0 - 1.0;\n"
+"    float wv = pos.w;\n"
+"    gl_Position = vec4(ndc * wv, zn * wv, wv);\n"
+"    gl_ClipDistance[0] = (pos.z - u_near) * wv;\n"
+"    gl_ClipDistance[1] = wv - 1e-3;\n"
+"    gl_PointSize = 1.0;\n"
+"}\n";
