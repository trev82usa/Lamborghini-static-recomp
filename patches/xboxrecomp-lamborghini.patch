+static void raster_xf_point(const Nv2aVshOutput *v)
+{
+    const float *p = v->pos;
+    uint8_t *mem = (uint8_t *)xbox_GetMemoryOffset();
+    uint32_t bpp = surface_bpp();
+    float *zb = NULL, *zp = NULL;
