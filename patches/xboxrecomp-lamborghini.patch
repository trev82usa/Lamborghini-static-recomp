+"            vec3 A = read_rgb(f0 >> 24), B = read_rgb(f0 >> 16);\n"
+"            vec3 C = read_rgb(f0 >> 8), D = read_rgb(f0);\n"
+"            outc.rgb = D + C * (1.0 - A) + B * A;\n"
+"            outc.a = read_alpha(f1 >> 8);\n"
+"        } else {\n"
+"            outc = R[12];\n"
+"        }\n"
+"        outc = clamp(outc, 0.0, 1.0);\n"
+"        if (u_dbgview >= 1 && u_dbgview <= 4) outc = vec4(t[u_dbgview - 1].rgb, 1.0);\n"
+"        if (u_dbgview == 5) outc = vec4(clamp(v_d0.rgb, 0.0, 1.0), 1.0);\n"
+"        if (u_dbgview == 6) outc = vec4(clamp(v_d1.rgb, 0.0, 1.0), 1.0);\n"
+"    }\n"
+"    if (u_atest != 0 && u_mode != 2 && !alpha_pass(outc.a)) discard;\n"
+"    o_color = outc;\n"
+"}\n";
+
+static GLuint compile(GLenum type, const char *src)
+{
+    GLuint sh = glCreateShader(type);
+    GLint ok = 0;
+    glShaderSource(sh, 1, &src, NULL);
+    glCompileShader(sh);
+    glGetShaderiv(sh, GL_COMPILE_STATUS, &ok);
+    if (!ok) {
+        char log[4096];
+        glGetShaderInfoLog(sh, sizeof log, NULL, log);
+        fprintf(stderr, "[GL] %s shader failed:\n%s\n",
+                type == GL_VERTEX_SHADER ? "vertex" : "fragment", log);
+        glDeleteShader(sh);
+        return 0;
+    }
+    return sh;
+}
+
+static GLuint link_prog(const char *vsrc, Locs *L)
+{
+    GLuint vs = compile(GL_VERTEX_SHADER, vsrc), fs = compile(GL_FRAGMENT_SHADER, FS);
+    GLuint prog;
+    GLint ok = 0;
+    int i;
+    char name[32];
+
+    if (!vs || !fs)
+        return 0;
+    prog = glCreateProgram();
+    glAttachShader(prog, vs);
+    glAttachShader(prog, fs);
+    glLinkProgram(prog);
+    glGetProgramiv(prog, GL_LINK_STATUS, &ok);
+    glDeleteShader(vs);
+    glDeleteShader(fs);
+    if (!ok) {
+        char log[4096];
+        glGetProgramInfoLog(prog, sizeof log, NULL, log);
+        fprintf(stderr, "[GL] link failed:\n%s\n", log);
+        glDeleteProgram(prog);
+        return 0;
+    }
+    glUseProgram(prog);
+#define LOC(f, n) L->f = glGetUniformLocation(prog, n)
+    LOC(size, "u_size"); LOC(zscale, "u_zscale"); LOC(mode, "u_mode");
+    LOC(z01, "u_z01");
+    LOC(textured, "u_textured"); LOC(texscale, "u_texscale");
+    LOC(texvalid, "u_texvalid"); LOC(texcubeflag, "u_texcubeflag");
+    LOC(cicw, "u_cicw"); LOC(aicw, "u_aicw"); LOC(cocw, "u_cocw");
+    LOC(aocw, "u_aocw"); LOC(f0, "u_f0"); LOC(f1, "u_f1");
+    LOC(final0, "u_final0"); LOC(final1, "u_final1");
+    LOC(fc0, "u_fc0"); LOC(fc1, "u_fc1"); LOC(control, "u_control");
+    LOC(stageprog, "u_stageprog"); LOC(clipmode, "u_clipmode");
+    LOC(bumpmat, "u_bumpmat"); LOC(bumplum, "u_bumplum"); LOC(otherin, "u_otherin");
+    LOC(dotmap, "u_dotmap"); LOC(eye, "u_eye");
+    LOC(dbgview, "u_dbgview");
+    LOC(fogcolor, "u_fogcolor"); LOC(atest, "u_atest");
+    LOC(afunc, "u_afunc"); LOC(aref, "u_aref");
+    LOC(vprog, "u_vprog"); LOC(vconst, "u_vconst"); LOC(vnins, "u_vnins");
+    LOC(aa, "u_aa"); LOC(near, "u_near"); LOC(fogp, "u_fogp"); LOC(fogmode, "u_fogmode");
+    LOC(packed, "u_packed"); LOC(hud, "u_hud");
+#undef LOC
+    /* Units 0-3: the 2D sampler of each stage; 4-7: its cube sampler. */
+    for (i = 0; i < 4; i++) {
+        snprintf(name, sizeof name, "u_tex2d[%d]", i);
+        L->tex2d[i] = glGetUniformLocation(prog, name);
+        glUniform1i(L->tex2d[i], i);
+        snprintf(name, sizeof name, "u_texcube[%d]", i);
+        L->texcube[i] = glGetUniformLocation(prog, name);
+        glUniform1i(L->texcube[i], 4 + i);
+    }
+    return prog;
+}
+
+static int build_program(void)
+{
+    s_prog = link_prog(VS, &U_cpu);
+    if (!s_prog)
+        return 0;
+    /* The vertex-program path is optional: without it the CPU transforms. */
+    s_prog_vsh = link_prog(VS_VSH, &U_vsh);
+    if (!s_prog_vsh)
+        fprintf(stderr, "[GL] vertex-program shader unavailable; CPU transform\n");
+    return 1;
+}
