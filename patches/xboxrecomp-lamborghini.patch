+static uint32_t deposit(uint32_t v, uint32_t mask)
+{
+    uint32_t r = 0, bit;
+    for (bit = 1; mask; bit <<= 1) {
+        uint32_t low = mask & (~mask + 1u);
+        if (v & bit)
+            r |= low;
+        mask &= mask - 1u;
+    }
+    return r;
+}
