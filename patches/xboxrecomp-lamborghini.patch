+static void osd_draw(SDL_Renderer *ren, double fps, double low)
+{
+    char a[32], b[32];
+    int w = 0, h = 0, px, len, bw;
+    SDL_Rect bg;
+    /* Logical coordinates: the renderer is set to the 640x480 frame. */
+    SDL_RenderGetLogicalSize(ren, &w, &h);
+    if (!w || !h)
+        SDL_GetRendererOutputSize(ren, &w, &h);
+    px = h / 160;
+    if (px < 2) px = 2;
+    snprintf(a, sizeof a, "%.0f FPS", fps);
+    snprintf(b, sizeof b, "LOW %.0f", low);
+    len = (int)(strlen(a) > strlen(b) ? strlen(a) : strlen(b));
+    bw = len * 4 * px + 2 * px;
+    bg.x = w - bw - 2 * px; bg.y = 2 * px; bg.w = bw; bg.h = 14 * px;
+    SDL_SetRenderDrawBlendMode(ren, SDL_BLENDMODE_BLEND);
+    SDL_SetRenderDrawColor(ren, 0, 0, 0, 160);
+    SDL_RenderFillRect(ren, &bg);
+    SDL_SetRenderDrawColor(ren, fps >= 58.0 ? 120 : 255, fps >= 29.0 ? 255 : 120, 120, 255);
+    osd_text(ren, bg.x + px, bg.y + px, px, a);
+    SDL_SetRenderDrawColor(ren, 220, 220, 220, 255);
+    osd_text(ren, bg.x + px, bg.y + 8 * px, px, b);
+    SDL_SetRenderDrawBlendMode(ren, SDL_BLENDMODE_NONE);
