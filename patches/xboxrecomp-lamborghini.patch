+/* Transform the batch's n indices into s_xf.
+ *
+ * Each distinct index once: indexed meshes name most vertices two or three
+ * times, and every repeat used to run the whole vertex program again. Then,
+ * for a vertex-program batch big enough to be worth waking it, the distinct
+ * vertices are split across the raster pool's threads, which sit idle while
+ * the executor transforms. Programs that write the constant file
+ * (CXT_WRITE) are order-dependent and stay on this thread, as does the
+ * fixed-function path. */
+#define XF_PAR_MIN 96
+static int xf_transform(uint32_t n)
+{
+    static uint32_t *uidx, *remap, *hkey, *hval, hcap;
+    static Nv2aVshOutput *uout;
+    uint32_t i, nu = 0, mask, nthreads;
