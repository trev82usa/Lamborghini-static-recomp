+ * to fit, so the extra resolution shows instead of being shrunk first. */
+void xbox_FramebufferWindowPresentHostSized(const void *px, uint32_t pitch,
+                                            uint32_t w, uint32_t h)
+{
+    struct fb_slot *s;
