+            char b[8]; snprintf(b, sizeof b, "%d", v);
+            setenv("RECOMP_GL_SCALE", v ? b : "auto", 0);
+        } else if (sscanf(line, "widescreen=%d", &v) == 1) {
+            set_wide = v != 0;
+        } else if (sscanf(line, "hud_edges=%d", &v) == 1) {
+            set_hud_edges = v != 0;
+        } else if (sscanf(line, "unlock_cars=%d", &v) == 1) {
+            set_cars = v != 0;
+        } else if (sscanf(line, "unlock_tracks=%d", &v) == 1) {
+            set_tracks = v != 0;
+        } else if (sscanf(line, "smooth=%d", &v) == 1) {
+            set_smooth = v != 0;
+        } else if (sscanf(line, "fullscreen=%d", &v) == 1) {
+            set_full = v != 0;
+        } else if (sscanf(line, "fps_counter=%d", &v) == 1) {
+            setenv("RECOMP_FPS_OVERLAY", v ? "1" : "0", 0);
+        }
+    }
+    fclose(f);
