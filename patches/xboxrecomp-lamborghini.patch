+static void osd_text(SDL_Renderer *ren, int x, int y, int px, const char *t)
+{
+    for (; *t; t++, x += 4 * px) {
+        uint16_t bits = 0;
+        size_t g;
+        int r, c;
+        int ch = (*t >= 'a' && *t <= 'z') ? *t - 32 : *t;
+        for (g = 0; g < sizeof osd_glyph / sizeof osd_glyph[0]; g++)
+            if (osd_glyph[g][0] == (uint16_t)ch)
+                bits = osd_glyph[g][1];
+        for (r = 0; r < 5; r++)
+            for (c = 0; c < 3; c++)
+                if (bits & (1u << (14 - (r * 3 + c)))) {
+                    SDL_Rect q = { x + c * px, y + r * px, px, px };
+                    SDL_RenderFillRect(ren, &q);
+                }
+    }
