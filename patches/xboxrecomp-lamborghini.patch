+        remap = (uint32_t *)malloc(NV_MAX_INDICES * sizeof *remap);
+        uout = (Nv2aVshOutput *)malloc(NV_MAX_INDICES * sizeof *uout);
+        hcap = 1u << 17;
+        hkey = (uint32_t *)malloc(hcap * sizeof *hkey);
+        hval = (uint32_t *)malloc(hcap * sizeof *hval);
+        if (!uidx || !remap || !uout || !hkey || !hval)
+            return 0;
+    }
+    /* Distinct indices: open addressing, table sized to the batch. */
+    for (mask = 255; mask + 1 < n * 2 && mask + 1 < hcap; mask = mask * 2 + 1)
+        ;
+    memset(hkey, 0xFF, (mask + 1) * sizeof *hkey);
+    for (i = 0; i < n; i++) {
+        uint32_t k = s_gpu.idx[i], h = (k * 2654435761u) & mask;
+        while (hkey[h] != 0xFFFFFFFFu && hkey[h] != k)
+            h = (h + 1) & mask;
+        if (hkey[h] == 0xFFFFFFFFu) {
+            hkey[h] = k;
+            hval[h] = nu;
+            uidx[nu++] = k;
+        }
+        remap[i] = hval[h];
+    }
+    nthreads = (uint32_t)raster_pool_size();
+    {
+        static int par = -1;
+        if (par < 0) {
+            const char *e = getenv("RECOMP_VSH_PARALLEL");
+            par = !(e && *e == '0');
+        }
+        if (!par)
+            nthreads = 1;
+    }
+    if (nthreads > 1 && nu >= XF_PAR_MIN && batch_uses_program()
+            && !nv2a_vsh_cxt_write()) {
+        uint32_t k;
+        nv2a_vsh_prepare();             /* workers only read the decode */
+        s_pool.job = 1;
+        s_pool.vtx_idx = uidx;
+        s_pool.vtx_out = uout;
+        s_pool.vtx_n = nu;
+        s_pool.vtx_fail = 0;
+        s_pool.pending = (LONG)nthreads - 1;
+        for (k = 0; k + 1 < nthreads; k++)
+            SetEvent(s_pool.start[k]);
+        vtx_chunk((int)nthreads - 1, (int)nthreads);
+        while (WaitForSingleObject(s_pool.done, 3000) == WAIT_TIMEOUT) {
+            fprintf(stderr, "[VTXPOOL] still waiting: pending %ld of %u, n %u;"
+                    " progress", (long)s_pool.pending, nthreads - 1, nu);
+            for (k = 0; k < nthreads; k++)
+                fprintf(stderr, " %08X", s_vtx_prog[k]);
+            fprintf(stderr, "\n");
+        }
+        s_pool.job = 0;
+        if (s_pool.vtx_fail)
+            return 0;
+    } else {
+        for (i = 0; i < nu; i++)
+            if (!transform_vertex(uidx[i], &uout[i]))
+                return 0;
+    }
+    for (i = 0; i < n; i++)
+        s_xf[i] = uout[remap[i]];
+    return 1;
+}
