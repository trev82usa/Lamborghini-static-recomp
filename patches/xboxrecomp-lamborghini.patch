+"    vec4 pos = R[12];\n"
+"    if (pos.w == 0.0 && (floatBitsToUint(pos.w) >> 31) == 0u) pos.w = 1.0;\n"
+"    if (isinf(pos.w) && pos.w > 0.0) pos.w = 1.0;\n"
